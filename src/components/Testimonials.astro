---
/**
 * Testimonial wall.
 *
 * Add ONLY real reviews copied word-for-word from your Google Business Profile
 * (with the customer's permission) to src/content/testimonials/, each with
 * `verified: true`. Unverified entries are never displayed, and pages hide
 * their review sections entirely while there are no verified reviews.
 */
import { getCollection, render } from 'astro:content';
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  limit?: number;
  featuredOnly?: boolean;
}
const { limit, featuredOnly = false } = Astro.props;

// Only real reviews (verified: true) are ever shown.
let entries = (await getCollection('testimonials')).filter((r) => r.data.verified).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
if (featuredOnly) entries = entries.filter((r) => r.data.featured);
if (limit) entries = entries.slice(0, limit);

const reviews = await Promise.all(
  entries.map(async (r) => ({ ...r, Content: (await render(r)).Content }))
);

const unverified = reviews.some((r) => !r.data.verified);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<div class="tw">
  {
    site.rating.verified && (
      <div class="tw-agg">
        <span class="tw-stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} class="star" />)}
        </span>
        <p>
          <strong>{site.rating.value.toFixed(1)}</strong> from {site.rating.count} Google
          reviews
        </p>
      </div>
    )
  }

  <ul class="tw-grid">
    {
      reviews.map((r, i) => (
        <li class:list={['tw-cell', i === 0 && 'tw-feature']} data-reveal>
          <figure class="tw-card">
            <div class="tw-stars" aria-label={`${r.data.rating} out of 5 stars`}>
              {Array.from({ length: r.data.rating }).map(() => (
                <Icon name="star" size={14} class="star" />
              ))}
            </div>
            <blockquote>
              <r.Content />
            </blockquote>
            <figcaption>
              <span class="tw-author">{r.data.author}</span>
              <span class="tw-meta">
                {r.data.city} · {r.data.service} · {fmt(r.data.date)}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  {
    unverified && (
      <p class="tw-notice">
        <Icon name="shield" size={15} />
        <span>
          <strong>Build note:</strong> these are placeholder reviews for layout only. Swap
          in real Google reviews and set <code>verified: true</code> in each file under{' '}
          <code>src/content/testimonials/</code>. Star-rating schema stays switched off
          until then.
        </span>
      </p>
    )
  }
</div>

<style>
  .tw {
    display: grid;
    gap: var(--sp-6);
  }
  .tw-agg {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .tw-agg strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .tw-stars {
    display: inline-flex;
    gap: 2px;
    color: var(--accent);
  }
  .tw-stars :global(.star) {
    fill: currentColor;
  }

  .tw-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .tw-card {
    height: 100%;
    display: grid;
    align-content: start;
    gap: var(--sp-4);
    padding: var(--sp-6);
    margin: 0;
    background: var(--bg);
  }
  .tw-card blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .tw-card blockquote :global(p + p) {
    margin-top: var(--sp-3);
  }
  .tw-card figcaption {
    display: grid;
    gap: 3px;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }
  .tw-author {
    font-weight: 750;
    font-size: 0.94rem;
    letter-spacing: -0.015em;
  }
  .tw-meta {
    font-size: 0.79rem;
    color: var(--fg-muted);
  }

  @media (min-width: 800px) {
    .tw-grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
    .tw-feature {
      grid-row: span 1;
    }
    .tw-feature .tw-card {
      padding: var(--sp-7);
    }
    .tw-feature blockquote {
      font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.55rem);
    }
  }

  .tw-notice {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: start;
    padding: var(--sp-4);
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .tw-notice :global(svg) {
    color: var(--accent-deep);
    margin-top: 2px;
  }
  .tw-notice code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--surface-sunk);
    padding: 1px 4px;
    border-radius: 2px;
  }
</style>
