---
/**
 * Schema.org JSON-LD.
 *
 * Rules that must not be broken here:
 *   • NO Review and NO AggregateRating nodes, ever. Dominion Haul has no
 *     reviews yet, and fabricated review markup risks a manual penalty.
 *   • NO streetAddress. Service-area business: locality + region only.
 *   • sameAs only ever contains real URLs pasted into site.links. While those
 *     are null, sameAs is omitted rather than pointing at generic network roots.
 *
 * The full LocalBusiness node is emitted once, on the homepage. Every other
 * page references it by @id, which is what Google prefers over repeating the
 * whole entity on each URL.
 */
import { site, profileLinks } from '../config/site';
import { priceFloor, priceCeiling } from '../config/pricing';

interface FaqItem {
  q: string;
  a: string;
}
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  type?: 'WebPage' | 'Service' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  title: string;
  description: string;
  url: string;
  faq?: FaqItem[];
  breadcrumbs?: Crumb[];
  service?: { name: string; description: string };
  areaServed?: { name: string; lat: number; lng: number };
  image?: string;
}

const {
  type = 'WebPage',
  title,
  description,
  url,
  faq = [],
  breadcrumbs = [],
  service,
  areaServed,
  image,
} = Astro.props;

const origin = Astro.site?.origin ?? 'https://dominionhaul.com';
const abs = (p: string) => new URL(p, origin).href;
const BIZ = `${origin}/#business`;
const SITE_ID = `${origin}/#website`;
const logoUrl = abs('/images/logo.png');
const primaryImage = image ? abs(image) : logoUrl;

const isHome = url === '/' || url === '';

const dayMap: Record<string, string> = {
  Monday: 'Mo',
  Tuesday: 'Tu',
  Wednesday: 'We',
  Thursday: 'Th',
  Friday: 'Fr',
  Saturday: 'Sa',
  Sunday: 'Su',
};

/** The four counties, as administrative areas. */
const countyAreas = site.counties.map((name) => ({
  '@type': 'AdministrativeArea',
  name: `${name}, Virginia`,
}));

const graph: Record<string, unknown>[] = [];

if (isHome) {
  const business: Record<string, unknown> = {
    '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
    '@id': BIZ,
    name: site.name,
    legalName: site.legalName,
    description: site.description,
    url: origin,
    telephone: site.phone.e164,
    email: site.email,
    image: [logoUrl],
    logo: { '@type': 'ImageObject', url: logoUrl, width: 1200, height: 361 },
    priceRange: `$${priceFloor}–$${priceCeiling}`,
    currenciesAccepted: 'USD',
    paymentAccepted: 'Cash, Credit Card, Debit Card',
    slogan: site.tagline,
    // Service-area business: no streetAddress, no postalCode.
    address: {
      '@type': 'PostalAddress',
      addressLocality: site.address.city,
      addressRegion: site.address.state,
      addressCountry: site.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.geo.lat,
      longitude: site.geo.lng,
    },
    areaServed: countyAreas,
    openingHoursSpecification: site.hours.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days.map((d) => dayMap[d]),
      opens: h.open,
      closes: h.close,
    })),
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: site.phone.e164,
        contactType: 'customer service',
        areaServed: 'US-VA',
        availableLanguage: ['English'],
      },
    ],
  };

  // Only real, pasted-in URLs. Omitted entirely while the placeholders are null.
  if (profileLinks.length) {
    business.sameAs = profileLinks.map((l) => l.url);
  }

  graph.push(business);
}

const pageId = `${abs(url)}#page`;

graph.push({
  '@type': type,
  '@id': pageId,
  url: abs(url),
  name: title,
  description,
  isPartOf: { '@id': SITE_ID },
  about: { '@id': BIZ },
  primaryImageOfPage: { '@type': 'ImageObject', url: primaryImage },
  inLanguage: 'en-US',
  ...(breadcrumbs.length ? { breadcrumb: { '@id': `${abs(url)}#breadcrumbs` } } : {}),
});

if (isHome) {
  graph.push({
    '@type': 'WebSite',
    '@id': SITE_ID,
    url: origin,
    name: site.name,
    description: site.description,
    publisher: { '@id': BIZ },
    inLanguage: 'en-US',
  });
}

/** BreadcrumbList — service pages and town pages both pass crumbs. */
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${abs(url)}#breadcrumbs`,
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.url),
    })),
  });
}

if (service) {
  const place = areaServed
    ? {
        '@type': 'Place',
        name: areaServed.name,
        geo: {
          '@type': 'GeoCoordinates',
          latitude: areaServed.lat,
          longitude: areaServed.lng,
        },
      }
    : null;

  graph.push({
    '@type': 'Service',
    '@id': `${abs(url)}#service`,
    name: service.name,
    description: service.description,
    serviceType: service.name,
    category: 'Junk Removal',
    provider: { '@id': BIZ },
    areaServed: place ? [place] : countyAreas,
    // Price range only — no Offer node asserting a single price for a
    // volume-based service whose final number is confirmed on site.
    offers: {
      '@type': 'Offer',
      url: abs(url),
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: priceFloor,
        maxPrice: priceCeiling,
        priceCurrency: 'USD',
        valueAddedTaxIncluded: false,
      },
      availability: 'https://schema.org/InStock',
    },
  });
}

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${abs(url)}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
