---
/**
 * Dominion Haul logo. `inverted` uses the white-lettered version for dark
 * backgrounds (footer). Source art: public/images/logo.png (3.33:1).
 */
interface Props {
  inverted?: boolean;
  href?: string | false;
  size?: 'nav' | 'lockup';
}
const { inverted = false, href = '/', size = 'nav' } = Astro.props;
const Tag = href === false ? 'span' : 'a';
---

<Tag
  href={href === false ? undefined : href}
  class:list={['wm', `wm-${size}`]}
  aria-label={href === false ? undefined : 'Dominion Haul home'}
>
  <img
    src={inverted ? '/images/logo-light.png' : '/images/logo.png'}
    alt="Dominion Haul"
    class="wm-logo"
    width="1200"
    height="361"
    decoding="async"
  />
</Tag>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex: none;
    transition: opacity var(--dur) var(--ease);
  }
  a.wm:hover {
    opacity: 0.88;
  }
  .wm-logo {
    display: block;
    width: auto;
    height: 40px;
  }
  .wm-lockup .wm-logo {
    height: 56px;
  }
  @media (min-width: 1024px) {
    .wm-nav .wm-logo {
      height: 48px;
    }
  }
</style>
