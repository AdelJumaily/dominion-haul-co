---
import { site, phoneHref, smsHref } from '../config/site';
import { services } from '../config/services';
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { getCollection } from 'astro:content';

const cities = (await getCollection('locations'))
  .filter((l) => l.data.kind === 'city')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const year = new Date().getFullYear();
---

<footer class="site-footer" data-band="dark">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <BrandMark inverted size="lockup" />
        <p class="foot-blurb">
          Local junk removal and hauling based in Chantilly, VA. Serving Fairfax, Loudoun,
          Prince William and Arlington counties.
        </p>
        <div class="foot-contact">
          <a href={phoneHref} class="foot-phone"><Icon name="phone" size={20} />{site.phone.display}</a>
          <a href={smsHref} class="foot-link"><Icon name="message" size={16} />Text us a photo</a>
          <a href={`mailto:${site.email}`} class="foot-link"><Icon name="mail" size={16} />{site.email}</a>
          <span class="foot-link"><Icon name="clock" size={16} />{site.hoursLabel}</span>
        </div>
      </div>

      <nav class="foot-cols" aria-label="Footer">
        <div class="foot-col">
          <h2>Services</h2>
          <ul>
            {services.map((s) => <li><a href={`/services/${s.id}`}>{s.title}</a></li>)}
          </ul>
        </div>

        <div class="foot-col">
          <h2>Company</h2>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/commercial">Commercial Partners</a></li>
            <li><a href="/locations">Service Area</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/reviews">Reviews</a></li>
            <li><a href="/contact">Free Quote</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <h2>Areas We Serve</h2>
          <ul class="foot-cities">
            {cities.map((c) => <li><a href={`/locations/${c.id}`}>{c.data.title}</a></li>)}
          </ul>
        </div>
      </nav>
    </div>

    <div class="foot-bottom">
      <p>&copy; {year} {site.name}. Fully insured.</p>
      <p>Based in Chantilly, VA</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--accent-deep);
    color: #fff;
    padding-block: var(--sp-8) var(--sp-6);
    border-top: 5px solid var(--gold);
  }
  .foot-top {
    display: grid;
    gap: var(--sp-7);
  }
  .foot-blurb {
    margin-top: var(--sp-5);
    color: #c5d3cc;
    max-width: 40ch;
    font-size: 0.97rem;
  }
  .foot-contact {
    margin-top: var(--sp-5);
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }
  .foot-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
  }
  .foot-phone:hover {
    color: #fff;
  }
  .foot-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: #c5d3cc;
    text-decoration: none;
    font-size: 0.95rem;
  }
  a.foot-link:hover {
    color: #fff;
  }

  .foot-cols {
    display: grid;
    gap: var(--sp-6);
  }
  .foot-col h2 {
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    margin-bottom: var(--sp-4);
  }
  .foot-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .foot-col a {
    color: #dce6e1;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .foot-col a:hover {
    color: var(--gold);
  }
  .foot-cities {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .foot-bottom {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid rgb(255 255 255 / 0.15);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    justify-content: space-between;
    font-size: 0.87rem;
    color: #a9bbb3;
  }

  @media (min-width: 640px) {
    .foot-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .foot-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--sp-8);
    }
    .foot-cols {
      grid-template-columns: 1.3fr 0.9fr 1.1fr;
    }
  }
</style>
