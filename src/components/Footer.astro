---
import { site, phoneHref } from '../config/site';
import { services } from '../config/services';
import { images, type ImageKey } from '../config/site';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();

const shortName: Record<string, string> = {
  'junk-removal': 'Household junk',
  'furniture-removal': 'Furniture',
  'appliance-removal': 'Appliances',
  'garage-basement-attic-cleanouts': 'Garage and attic',
  'estate-cleanouts': 'Estate cleanouts',
  'yard-waste-removal': 'Yard waste',
  'construction-debris-removal': 'Remodel debris',
};

const shots: ImageKey[] = ['garageRenovation', 'constructionYard', 'yardDemo', 'constructionDebris'];
---

<footer class="bg-brand text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <BrandMark inverted size="lockup" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">
        Junk removal out of Chantilly, across Northern Virginia.
      </p>
      <a href={phoneHref} class="mt-4 inline-block text-sm font-semibold hover:underline">{site.phone.display}</a>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-white">Company</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/70">
        <li><a href="/" class="hover:text-white">Home</a></li>
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href="/pricing" class="hover:text-white">Pricing</a></li>
        <li><a href="/locations" class="hover:text-white">Areas</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-white">Services</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/70">
        {services.map((s) => (
          <li><a href={`/services/${s.id}`} class="hover:text-white">{shortName[s.id] ?? s.title}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-white">Gallery</h2>
      <ul class="mt-4 grid grid-cols-2 gap-2">
        {
          shots.map((key) => (
            <li>
              <img
                src={images[key].src}
                alt={images[key].alt}
                width={images[key].width}
                height={images[key].height}
                loading="lazy"
                class="aspect-square w-full rounded-md object-cover"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-7xl px-4 py-5 text-sm text-white/50">
      &copy; {year} {site.name}
    </p>
  </div>
</footer>
