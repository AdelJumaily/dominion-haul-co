---
/**
 * The price table. Every number comes from config/pricing.ts.
 */
import Icon from './Icon.astro';
import { tiers, included, quotedSeparately, heavyMaterial, priceRule } from '../config/pricing';

interface Props {
  /** Hides the inclusions panel — used where space is tight. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="pricing">
  <div class="tiers">
    {
      tiers.map((t) => (
        <article class={`tier ${t.popular ? 'tier-popular' : ''}`}>
          {t.popular && <span class="tier-flag">Most asked for</span>}
          <h3>{t.name}</h3>
          <p class="tier-price">{t.price}</p>
          <p class="tier-covers">{t.covers}</p>
        </article>
      ))
    }
  </div>

  <p class="heavy">
    <Icon name="truck" size={17} />
    <span>
      <strong>{heavyMaterial.items}</strong> are priced by weight, not by space. We quote
      those on site.
    </span>
  </p>

  {
    !compact && (
      <aside class="included">
        <div>
          <h3>That price covers</h3>
          <ul class="incl-list">
            {included.map((i) => (
              <li>
                <Icon name="check" size={17} class="ok" />
                {i}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Quoted separately</h3>
          <ul class="incl-list">
            {quotedSeparately.map((i) => (
              <li>
                <Icon name="x" size={17} class="warn" />
                {i}
              </li>
            ))}
          </ul>
        </div>
        <p class="incl-note">{priceRule}</p>
      </aside>
    )
  }
</div>

<style>
  .pricing {
    display: grid;
    gap: var(--sp-5);
  }

  .tiers {
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 560px) {
    .tiers {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .tiers {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    background: var(--card, #fff);
    border: 1px solid var(--rule, var(--line));
    border-radius: var(--r-lg);
  }
  .tier-popular {
    border-color: var(--accent);
    border-width: 2px;
    box-shadow: var(--shadow-md);
  }
  .tier-flag {
    position: absolute;
    top: -11px;
    left: var(--sp-5);
    background: var(--accent);
    color: #f4f7f4;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: var(--r-sm);
  }
  .tier h3 {
    font-size: var(--step-1);
  }
  .tier-price {
    font-size: var(--step-3);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--accent-deep, var(--accent));
  }
  .tier-covers {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fg-muted, var(--muted));
    margin-top: auto;
  }

  .heavy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: start;
    padding: var(--sp-4);
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-md);
    font-size: 0.93rem;
    line-height: 1.55;
  }
  .heavy :global(svg) {
    color: var(--accent-deep, var(--accent));
    margin-top: 3px;
  }

  .included {
    display: grid;
    gap: var(--sp-6);
    background: var(--card, #fff);
    border: 1px solid var(--rule, var(--line));
    border-radius: var(--r-lg);
    padding: var(--sp-6);
  }
  .included h3 {
    font-size: var(--step-1);
    margin-bottom: var(--sp-4);
  }
  .incl-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .incl-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: start;
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .incl-list :global(.ok) {
    color: var(--success);
    margin-top: 2px;
  }
  .incl-list :global(.warn) {
    color: var(--accent-deep, var(--accent));
    margin-top: 2px;
  }
  .incl-note {
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule, var(--line));
    font-size: 0.96rem;
    font-weight: 700;
  }

  @media (min-width: 800px) {
    .included {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-7);
      align-items: start;
    }
    .incl-note {
      grid-column: 1 / -1;
    }
  }
</style>
