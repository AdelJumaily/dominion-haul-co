---
import { site, phoneHref, smsHref } from '../config/site';
import { buttonVariants } from './ui/button';
import { cn } from 'cn';

interface Props {
  heading?: string;
  sub?: string;
  context?: string;
}
const {
  heading = 'Ready to clear it out?',
  sub = 'Call or text a photo of what needs to go. We will get back to you with a price range.',
} = Astro.props;
---

<section class="bg-brand text-white">
  <div class="mx-auto grid max-w-7xl items-end gap-8 px-4 py-16 md:grid-cols-2">
    <div>
      <h2 class="font-heading text-4xl font-extrabold tracking-tight text-white md:text-5xl">{heading}</h2>
      <p class="mt-4 max-w-md text-lg leading-relaxed text-white/80">{sub}</p>
    </div>
    <div class="grid justify-items-start gap-4 md:justify-items-end">
      <a href={phoneHref} class="font-heading text-3xl font-extrabold tracking-tight text-white hover:underline md:text-4xl" data-track="call-cta">
        {site.phone.display}
      </a>
      <div class="flex flex-wrap gap-3">
        <a href="/contact" class={cn(buttonVariants(), "h-11 bg-white px-5 text-brand hover:bg-white/90")}>Get a free quote</a>
        <a href={smsHref} class={cn(buttonVariants({ variant: "outline" }), "h-11 border-white/40 bg-transparent px-5 text-white hover:bg-white/10 hover:text-white")}>Text a photo</a>
      </div>
      <p class="text-sm text-white/70">{site.hoursLabel}</p>
    </div>
  </div>
</section>
