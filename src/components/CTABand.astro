---
/**
 * Closing call-to-action. Dark slab with the phone number set at display size —
 * the single largest, highest-contrast element on the page.
 */
import { site, phoneHref, smsHref } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  sub?: string;
  /** Location/service pages pass their own name for a specific ask. */
  context?: string;
}
const {
  heading = 'Got a pile in Fairfax?',
  sub = 'Text a photo. We will text back a firm number — usually under fifteen minutes when we are not mid-carry.',
  context,
} = Astro.props;
---

<section class="cta-band" data-band="dark">
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p class="lede">{sub}</p>
    </div>

    <div class="cta-actions">
      <a href={phoneHref} class="cta-phone" data-track="call-cta">
        <span class="cta-phone-label">Call or text</span>
        <span class="cta-phone-num">{site.phone.display}</span>
      </a>
      <div class="btn-row cta-btns">
        <a href="/contact" class="btn">
          Get a free quote
          <Icon name="arrow" size={18} class="arrow" />
        </a>
        <a href={smsHref} class="btn btn-ghost">Text a photo</a>
      </div>
      <p class="cta-hours">{site.hoursLabel}</p>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--ink);
    color: var(--surface);
    padding-block: var(--section-y);
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--ink-line);
  }

  .cta-inner {
    position: relative;
    display: grid;
    gap: var(--sp-7);
    align-items: end;
  }
  .cta-copy h2 {
    font-size: var(--step-4);
    max-width: 14ch;
  }
  .cta-copy .lede {
    margin-top: var(--sp-4);
    max-width: 38ch;
  }

  .cta-actions {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }
  .cta-phone {
    display: grid;
    gap: 4px;
    text-decoration: none;
    color: var(--surface);
  }
  .cta-phone-label {
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
  }
  .cta-phone-num {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--accent);
    transition: color var(--dur) var(--ease);
  }
  .cta-phone:hover .cta-phone-num {
    color: var(--accent-hot);
  }
  .cta-hours {
    font-size: 0.83rem;
    color: var(--muted-light);
  }

  @media (min-width: 900px) {
    .cta-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--sp-9);
    }
    .cta-actions {
      justify-items: end;
      text-align: right;
    }
    .cta-phone {
      justify-items: end;
    }
    .cta-btns {
      justify-content: flex-end;
    }
  }
</style>
