---
/**
 * Image wrapper. Every photo on the site goes through here, referenced by key
 * from the manifest in config/site.ts.
 *
 * Always emits real width/height (prevents layout shift) and lazy-loads by
 * default. Pass `priority` for anything above the fold.
 */
import { images, type ImageKey } from '../config/site';

interface Props {
  imageKey: ImageKey;
  /** Overrides the natural aspect ratio when a layout needs a specific crop. */
  ratio?: string;
  /** Above-the-fold images must set this so they are not lazy-loaded. */
  priority?: boolean;
  /** Override the manifest alt text where page context makes it more specific. */
  alt?: string;
  sizes?: string;
  class?: string;
}

const {
  imageKey,
  ratio,
  priority = false,
  alt,
  sizes = '(max-width: 900px) 100vw, 50vw',
  class: className = '',
} = Astro.props;

const entry = images[imageKey];

if (!entry) {
  throw new Error(
    `Figure: unknown imageKey "${imageKey}". Add it to the images manifest in src/config/site.ts.`
  );
}

const aspect = ratio ?? `${entry.width}/${entry.height}`;
---

<div class={`frame ${className}`} style={`aspect-ratio:${aspect}`}>
  <img
    src={entry.src}
    alt={alt ?? entry.alt}
    width={entry.width}
    height={entry.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    sizes={sizes}
  />
</div>

<style>
  .frame {
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--surface-sunk);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
