---
import { site, phoneHref } from '../config/site';
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';
import { buttonVariants } from './ui/button';
import { cn } from 'cn';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');

const counties = (await getCollection('locations'))
  .filter((l) => l.data.kind === 'county')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<a class="skip-link" href="#main">Skip to content</a>

<header class="sticky top-3 z-50 px-3 md:px-4">
  <nav class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 rounded-2xl border border-white/70 bg-white/65 px-3 py-2.5 shadow-[0_8px_32px_rgba(7,75,57,0.12)] backdrop-blur-xl md:px-5" aria-label="Primary">
    <BrandMark />

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-stone-700 hover:bg-stone-100 md:hidden"
      data-collapse-toggle="mobile-nav"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14"></path>
      </svg>
    </button>

    <div class="hidden items-center gap-1 md:flex">
      <a
        href="/services"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium hover:bg-stone-100',
          isActive('/services') ? 'text-brand' : 'text-stone-800',
        ]}
        aria-current={isActive('/services') ? 'page' : undefined}
      >
        Services
      </a>

      <a
        href="/pricing"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium hover:bg-stone-100',
          isActive('/pricing') ? 'text-brand' : 'text-stone-800',
        ]}
        aria-current={isActive('/pricing') ? 'page' : undefined}
      >
        Pricing
      </a>

      <button
        id="areas-trigger"
        type="button"
        data-dropdown-toggle="areas-menu"
        data-dropdown-trigger="hover"
        data-dropdown-delay="80"
        class:list={[
          'inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium hover:bg-stone-100',
          isActive('/locations') ? 'text-brand' : 'text-stone-800',
        ]}
      >
        Areas
        <svg class="h-3.5 w-3.5" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
        </svg>
      </button>
      <div
        id="areas-menu"
        class="z-50 hidden w-56 rounded-xl border border-stone-200 bg-white py-2 shadow-xl"
      >
        <ul class="text-sm">
          {
            counties.map((c) => (
              <li>
                <a href={`/locations/${c.id}`} class="block px-4 py-2 text-stone-800 hover:bg-stone-50 hover:text-brand">
                  {c.data.title}
                </a>
              </li>
            ))
          }
          <li class="mt-1 border-t border-stone-100 pt-1">
            <a href="/locations" class="block px-4 py-2 font-semibold text-brand hover:bg-stone-50">
              All areas
            </a>
          </li>
        </ul>
      </div>

      <a
        href="/commercial"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium hover:bg-stone-100',
          isActive('/commercial') ? 'text-brand' : 'text-stone-800',
        ]}
        aria-current={isActive('/commercial') ? 'page' : undefined}
      >
        Commercial
      </a>
      <a
        href="/about"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium hover:bg-stone-100',
          isActive('/about') ? 'text-brand' : 'text-stone-800',
        ]}
        aria-current={isActive('/about') ? 'page' : undefined}
      >
        About
      </a>
    </div>

    <div class="hidden items-center gap-3 md:flex">
      <a href={phoneHref} class="text-sm font-semibold text-stone-900 hover:text-brand" data-track="call-header">
        {site.phone.display}
      </a>
      <a href="/contact" class={cn(buttonVariants(), "h-10 px-4 text-sm")}>Get a Free Quote</a>
    </div>

    <div id="mobile-nav" class="hidden w-full md:hidden">
      <div class="mt-2 space-y-1 border-t border-stone-100 pt-3">
        <a href="/services" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-800 hover:bg-stone-50">Services</a>
        <a href="/pricing" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-800 hover:bg-stone-50">Pricing</a>
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium text-stone-800 hover:bg-stone-50">
            Areas
            <svg class="h-4 w-4 text-stone-400 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
            </svg>
          </summary>
          <ul class="pb-2 pl-3">
            {
              counties.map((c) => (
                <li>
                  <a href={`/locations/${c.id}`} class="block rounded-lg px-3 py-2 text-sm text-stone-700 hover:bg-stone-50">
                    {c.data.title}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/locations" class="block rounded-lg px-3 py-2 text-sm font-semibold text-brand hover:bg-stone-50">
                All areas
              </a>
            </li>
          </ul>
        </details>
        <a href="/commercial" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-800 hover:bg-stone-50">Commercial</a>
        <a href="/about" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-800 hover:bg-stone-50">About</a>
        <div class="grid gap-2 px-1 pt-2">
          <a href={phoneHref} class={cn(buttonVariants(), "h-11")}>Call {site.phone.display}</a>
          <a href="/contact" class={cn(buttonVariants({ variant: "outline" }), "h-11")}>Get a Free Quote</a>
        </div>
      </div>
    </div>
  </nav>
</header>
