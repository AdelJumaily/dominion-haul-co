---
import { site, phoneHref, nav } from '../config/site';
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const locations = await getCollection('locations');
const counties = locations
  .filter((l) => l.data.kind === 'county')
  .sort((a, b) => a.data.order - b.data.order);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="container header-inner">
    <BrandMark />

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li class={item.mega ? 'has-mega' : ''}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                {item.mega && <Icon name="chevron" size={14} class="nav-chev" />}
              </a>

              {item.mega === 'services' && (
                <div class="mega">
                  <div class="mega-inner">
                    <p class="mega-title">What we haul</p>
                    <ul class="mega-list">
                      {services.map((s) => (
                        <li>
                          <a href={`/services/${s.id}`}>{s.data.title}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              {item.mega === 'locations' && (
                <div class="mega">
                  <div class="mega-inner">
                    <p class="mega-title">Where we work</p>
                    <ul class="mega-list">
                      {counties.map((c) => (
                        <li>
                          <a href={`/locations/${c.id}`}>{c.data.title}</a>
                        </li>
                      ))}
                      <li>
                        <a href="/locations" class="mega-all">
                          All cities &amp; towns
                        </a>
                      </li>
                    </ul>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href={phoneHref}
        class="header-call"
        data-track="call-header-icon"
        aria-label={`Call us at ${site.phone.display}`}
      >
        <Icon name="phone" size={19} />
      </a>
      <a href={phoneHref} class="header-phone" data-track="call-header">
        <Icon name="phone" size={17} />
        <span>{site.phone.display}</span>
      </a>
      <a href="/contact" class="btn header-quote">Get a quote</a>
      <button
        class="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul class="mm-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="mm-heading">Services</p>
      <ul class="mm-sub">
        {services.map((s) => <li><a href={`/services/${s.id}`}>{s.data.title}</a></li>)}
      </ul>
      <p class="mm-heading">Service area</p>
      <ul class="mm-sub">
        {counties.map((c) => <li><a href={`/locations/${c.id}`}>{c.data.title}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }

  .header-inner :global(.wm) {
    margin-right: auto;
  }

  .primary-nav {
    display: none;
  }
  .primary-nav > ul {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    list-style: none;
    padding: 0;
  }
  .primary-nav li {
    position: relative;
  }
  .primary-nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.5rem 0.7rem;
    font-size: 0.93rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .primary-nav > ul > li > a:hover {
    color: var(--accent-deep);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .primary-nav a[aria-current='page'] {
    color: var(--accent-deep);
  }
  .nav-chev {
    opacity: 0.5;
    transition: transform var(--dur) var(--ease);
  }
  .has-mega:hover .nav-chev {
    transform: rotate(180deg);
  }

  .mega {
    position: absolute;
    top: 100%;
    left: -0.5rem;
    padding-top: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease),
      visibility var(--dur);
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .mega-inner {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--sp-5);
    min-width: 300px;
  }
  .mega-title {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--sp-3);
  }
  .mega-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .mega-list a {
    display: block;
    padding: 0.5rem 0.6rem;
    margin-inline: -0.6rem;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: background var(--dur) var(--ease), padding-left var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .mega-list a:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    padding-left: 0.9rem;
    color: var(--accent-deep);
  }
  .mega-all {
    color: var(--accent-deep) !important;
    font-weight: 700 !important;
    border-top: 1px solid var(--line);
    margin-top: var(--sp-2) !important;
    padding-top: 0.7rem !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: none;
  }
  .header-call {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--accent);
    color: #f4f7f4;
    border-radius: var(--r-md);
    text-decoration: none;
    transition: background var(--dur) var(--ease), transform 220ms var(--ease);
  }
  .header-call:hover {
    background: var(--accent-hot);
    transform: translateY(-1px);
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 650;
    font-size: 0.95rem;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }
  .header-phone:hover {
    color: var(--accent-deep);
  }
  .header-quote {
    display: none;
    min-height: 42px;
    padding: 0.55rem 1.1rem;
    font-size: 0.92rem;
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    cursor: pointer;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .menu-btn:hover {
    border-color: var(--ink);
  }
  .menu-btn[aria-expanded='true'] {
    background: var(--ink);
    color: var(--surface);
    border-color: var(--ink);
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--surface);
    max-height: calc(100dvh - var(--header-h) - var(--callbar-h));
    overflow-y: auto;
    padding-block: var(--sp-5) var(--sp-6);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mm-list,
  .mm-sub {
    list-style: none;
    padding: 0;
  }
  .mm-list a {
    display: block;
    padding: 0.8rem 0;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mm-heading {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-3);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mm-sub {
    display: grid;
    gap: var(--sp-1);
  }
  .mm-sub a {
    display: block;
    padding: 0.4rem 0;
    font-size: 0.98rem;
    font-weight: 550;
    color: var(--muted);
    text-decoration: none;
  }
  .mm-sub a:hover {
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .header-phone {
      display: inline-flex;
    }
    .header-call {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    :root {
      --header-h: 74px;
    }
    .primary-nav {
      display: block;
    }
    .header-quote {
      display: inline-flex;
    }
    .menu-btn,
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      menu.hidden = open;
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
        menu.hidden = true;
        btn.focus();
      }
    });
  }
</script>
