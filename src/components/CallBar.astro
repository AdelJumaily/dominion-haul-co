---
/**
 * Fixed bottom action bar, mobile only.
 *
 * Phone traffic converts by tapping call, so the call/text/quote actions stay
 * pinned to the thumb zone on every page.
 * body{padding-bottom} in global.css reserves space so nothing is ever covered.
 */
import { site, phoneHref, smsHref } from '../config/site';
import Icon from './Icon.astro';
---

<div class="call-bar">
  <a href={phoneHref} class="cb-item cb-primary" data-track="call-bar">
    <Icon name="phone" size={19} />
    <span>Call now</span>
  </a>
  <a href={smsHref} class="cb-item" data-track="text-bar">
    <Icon name="message" size={19} />
    <span>Text</span>
  </a>
  <a href="/contact" class="cb-item" data-track="quote-bar">
    <Icon name="camera" size={19} />
    <span>Quote</span>
  </a>
</div>

<span class="sr-only">Call {site.name} at {site.phone.display}</span>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    background: var(--ink);
    border-top: 1px solid var(--ink-line);
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -4px 20px rgb(20 32 25 / 0.16);
  }
  .cb-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: var(--callbar-h);
    color: var(--surface);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border-left: 1px solid var(--ink-line);
    transition: background var(--dur) var(--ease);
  }
  .cb-item:first-child {
    border-left: 0;
  }
  .cb-item:active {
    background: var(--ink-soft);
  }
  .cb-primary {
    background: var(--accent);
    color: #f4f7f4;
  }
  .cb-primary:active {
    background: var(--accent-hot);
  }

  @media (min-width: 768px) {
    .call-bar {
      display: none;
    }
  }
</style>
