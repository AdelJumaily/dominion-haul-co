---
import { services } from '../config/services';
import { images } from '../config/site';
import { Card, CardHeader } from './ui/card';

interface Props {
  locationTitle?: string;
}
const { locationTitle } = Astro.props;
---

<ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
  {
    services.map((s) => {
      const photo = images[s.image];
      return (
        <li>
          <a href={`/services/${s.id}`} class="group block h-full">
            <Card className="h-full gap-0 overflow-hidden p-0 py-0 ring-stone-200 transition duration-200 group-hover:-translate-y-0.5 group-hover:shadow-lg">
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
              <CardHeader className="gap-1">
                <h3 class="font-heading text-lg font-extrabold text-stone-900 group-hover:text-brand">
                  {s.title}
                </h3>
                <p class="text-sm leading-relaxed text-stone-600">{s.short}</p>
              </CardHeader>
            </Card>
          </a>
        </li>
      );
    })
  }
</ul>
{locationTitle && <p class="sr-only">Services available in {locationTitle}</p>}
