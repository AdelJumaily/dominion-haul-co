---
/**
 * FAQ block. The accordion is the shadcn Accordion (Radix), rendered as a
 * React island. Schema.org FAQPage JSON-LD is emitted separately by
 * Schema.astro from the same array.
 */
import FaqList from './FaqList';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
  openFirst?: boolean;
}
const { items, title = 'Common questions', eyebrow = 'FAQ', openFirst = false } = Astro.props;
---

{
  items.length > 0 && (
    <div class="mx-auto grid max-w-3xl gap-6">
      <div>
        <p class="text-sm font-semibold text-brand">{eyebrow}</p>
        <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">
          {title}
        </h2>
      </div>
      <FaqList client:visible items={items} openFirst={openFirst} />
    </div>
  )
}
