---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import { site, phoneHref } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: d.title, url: `/blog/${entry.id}` },
];

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base
  title={d.metaTitle}
  description={d.metaDescription}
  ogType="article"
  schema={{
    type: 'BlogPosting',
    faq: d.faq ?? [],
    breadcrumbs: crumbs,
    article: {
      published: d.publishDate.toISOString(),
      modified: d.updatedDate?.toISOString(),
      author: d.author,
    },
  }}
>
  <Breadcrumbs crumbs={crumbs} />

  <article>
    <header class="post-hd">
      <div class="container container-tight">
        <span class="chip chip-accent">{d.category}</span>
        <h1>{d.title}</h1>
        <p class="lede mt-5">{d.description}</p>
        <div class="post-meta">
          <span>{d.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={d.publishDate.toISOString()}>{fmt(d.publishDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{d.readingMinutes} min read</span>
          {
            d.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {fmt(d.updatedDate)}</span>
              </>
            )
          }
        </div>
      </div>
    </header>

    <div class="section">
      <div class="container container-tight">
        <div class="prose post-body">
          <Content />
        </div>

        <aside class="post-cta">
          <div>
            <p class="eyebrow">Need this done rather than read about?</p>
            <h2>We'll give you a firm price today</h2>
          </div>
          <div class="btn-row">
            <a href={phoneHref} class="btn">
              <Icon name="phone" size={18} /> {site.phone.display}
            </a>
            <a href="/contact" class="btn btn-ghost">
              Send a photo <Icon name="arrow" size={17} class="arrow" />
            </a>
          </div>
        </aside>
      </div>
    </div>

    {
      d.faq && d.faq.length > 0 && (
        <section class="section-sm" data-band="dark">
          <div class="container">
            <FAQ items={d.faq} title="Quick answers" eyebrow="FAQ" />
          </div>
        </section>
      )
    }
  </article>

  {
    all.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <h2 class="more-head">Read next</h2>
          <ul class="more-grid">
            {all.map((p) => (
              <li>
                <a href={`/blog/${p.id}`} class="card card-link more-card">
                  <span class="chip">{p.data.category}</span>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                  <span class="link-arrow">
                    Read it <Icon name="arrow" size={16} class="arrow" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CTABand />
</Base>

<style>
  .post-hd {
    padding-block: var(--sp-8) var(--sp-6);
    background: linear-gradient(180deg, var(--surface-sunk), var(--surface));
    border-bottom: 1px solid var(--line);
  }
  .post-hd h1 {
    font-size: var(--step-4);
    margin-top: var(--sp-4);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
    font-size: 0.83rem;
    color: var(--muted);
  }

  /* Tables inside posts must scroll rather than break the page on mobile */
  .post-body :global(table) {
    font-size: 0.9rem;
  }
  .post-body :global(.table-wrap),
  .post-body :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .post-body :global(th),
  .post-body :global(td) {
    padding: var(--sp-3) var(--sp-4);
    white-space: nowrap;
  }
  .post-body :global(td:nth-child(2)) {
    white-space: normal;
    min-width: 24ch;
  }
  .post-body :global(hr) {
    border: 0;
    height: 1px;
    background: var(--line);
    margin-block: var(--sp-7);
  }
  .post-body :global(em) {
    color: var(--muted);
  }

  .post-cta {
    margin-top: var(--sp-8);
    padding: var(--sp-6);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    display: grid;
    gap: var(--sp-5);
  }
  .post-cta h2 {
    font-size: var(--step-2);
  }

  .more-head {
    font-size: var(--step-2);
    margin-bottom: var(--sp-5);
  }
  .more-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .more-card {
    height: 100%;
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--sp-5);
  }
  .more-card .chip {
    justify-self: start;
  }
  .more-card h3 {
    font-size: var(--step-1);
  }
  .more-card p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (min-width: 700px) {
    .more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .post-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
