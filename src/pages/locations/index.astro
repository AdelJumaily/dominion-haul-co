---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { buttonVariants } from '../../components/ui/button';
import { cn } from 'cn';
import { site } from '../../config/site';

const all = await getCollection('locations');
const counties = all
  .filter((l) => l.data.kind === 'county')
  .sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Service area', url: '/locations' },
];
---

<Base
  title="Where We Work | Junk Removal Across Northern Virginia"
  description="Dominion Haul covers Fairfax, Loudoun, Prince William and Arlington counties, including Reston, Ashburn, Vienna, Manassas and Woodbridge. Same prices everywhere, no distance fee."
  schema={{ type: 'CollectionPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">Where we work</p>
      <h1 class="mt-2 max-w-3xl font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
        Four counties. One price list.
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
        We work across Fairfax, Loudoun, Prince William, and Arlington out of {site.base}. Half a truck costs the same in Haymarket as it does in Vienna.
      </p>
    </div>
  </section>

  {
    counties.map((county, index) => {
      const cities = all
        .filter((l) => l.data.county === county.id)
        .sort((a, b) => a.data.title.localeCompare(b.data.title));
      return (
        <section class={index % 2 === 0 ? 'bg-white' : 'bg-[#f4f7f5]'}>
          <div class="mx-auto max-w-6xl px-4 py-14">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div class="max-w-2xl">
                <h2 class="font-heading text-3xl font-extrabold tracking-tight text-stone-900">
                  <a href={`/locations/${county.id}`} class="hover:text-brand">{county.data.title}</a>
                </h2>
                <p class="mt-3 text-stone-600">{county.data.lede}</p>
              </div>
              <a href={`/locations/${county.id}`} class={cn(buttonVariants({ variant: 'outline' }), 'h-11 shrink-0 border-stone-300 bg-white px-5')}>
                County page
              </a>
            </div>

            {cities.length > 0 && (
              <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {cities.map((c) => (
                  <li>
                    <a href={`/locations/${c.id}`} class="flex h-full flex-col rounded-2xl bg-white p-5 ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:shadow-md">
                      <span class="font-heading text-lg font-extrabold text-stone-900">{c.data.title}</span>
                      <span class="mt-2 text-sm leading-relaxed text-stone-600">{c.data.areas.slice(0, 4).join(' · ')}</span>
                      <span class="mt-4 border-t border-stone-200 pt-3 text-xs font-medium tracking-wide text-stone-500">{c.data.zips.join(' · ')}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}

            <details class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-stone-200">
              <summary class="cursor-pointer font-heading text-base font-extrabold text-stone-900">
                Everywhere else in {county.data.title}
              </summary>
              <ul class="mt-4 flex list-none flex-wrap justify-center gap-2">
                {county.data.areas.map((a) => (
                  <li class="rounded-full bg-[#f4f7f5] px-3 py-1 text-sm font-medium text-stone-700">{a}</li>
                ))}
              </ul>
              <p class="mt-4 text-center text-sm text-stone-500">
                These do not all have their own page. We cover them the same way, at the same prices.
              </p>
            </details>
          </div>
        </section>
      );
    })
  }

  <section class="bg-brand text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center">
      <h2 class="font-heading text-3xl font-extrabold tracking-tight md:text-4xl">Not sure if you're in it?</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/80">
        If you're in those four counties, call and we'll tell you straight away.
      </p>
      <a href="/contact" class={cn(buttonVariants(), 'mt-8 h-11 bg-white px-5 text-brand hover:bg-white/90')}>
        Check your address
      </a>
    </div>
  </section>

  <CTABand />
</Base>
