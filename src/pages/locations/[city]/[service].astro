---
/**
 * City × service landing pages — high-intent local SEO URLs like
 * /locations/reston/furniture-removal
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQ from '../../../components/FAQ.astro';
import CTABand from '../../../components/CTABand.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import Icon from '../../../components/Icon.astro';
import { site, phoneHref, smsHref } from '../../../config/site';

export async function getStaticPaths() {
  const locations = (await getCollection('locations')).filter((l) => l.data.kind === 'city');
  const services = await getCollection('services');

  return locations.flatMap((loc) =>
    services.map((svc) => ({
      params: { city: loc.id, service: svc.id },
      props: { loc, svc },
    }))
  );
}

const { loc, svc } = Astro.props;
const L = loc.data;
const S = svc.data;

const title = `${S.title} in ${L.title}, VA | Dominion Haul Co`;
const description = `${S.title} in ${L.title}, Virginia (${L.zips.slice(0, 3).join(', ')}). Same-day slots, published pricing from $${S.priceFrom}, local crew on the phone — not a franchise call centre.`;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Service area', url: '/locations' },
  { name: L.title, url: `/locations/${loc.id}` },
  { name: S.title, url: `/locations/${loc.id}/${svc.id}` },
];

const faq = [
  {
    q: `How much does ${S.title.toLowerCase()} cost in ${L.title}?`,
    a: `${S.title} in ${L.title} typically runs from $${S.priceFrom} to $${S.priceTo}, priced by how much room your stuff takes in the truck — not by the hour. Full load-size table is on our pricing page. Stairs and long carries in ${L.title} do not add a surcharge.`,
  },
  {
    q: `Do you offer same-day ${S.title.toLowerCase()} in ${L.title}?`,
    a: `Yes on most weekdays. We are based in Chantilly — ${L.responseTime.toLowerCase()}. Call or text a photo before noon and we can usually route a ${L.title} pickup the same afternoon.`,
  },
  {
    q: `What neighborhoods in ${L.title} do you cover?`,
    a: `All of ${L.title}${L.areas.length ? `, including ${L.areas.slice(0, 5).join(', ')}` : ''}. ZIPs ${L.zips.join(', ')}. If you are on the edge of ${L.countyLabel}, call — the answer is usually yes.`,
  },
  ...(S.faq.slice(0, 2) as { q: string; a: string }[]),
];

const siblingCities = (await getCollection('locations'))
  .filter((l) => l.data.kind === 'city' && l.data.county === L.county && l.id !== loc.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 8);
---

<Base
  title={title}
  description={description}
  geoPlacename={`${L.title}, VA`}
  geoPosition={L.geo}
  keywords={`${S.title} ${L.title}, ${S.title.toLowerCase()} ${L.title} VA, junk removal ${L.title}, ${L.zips.join(', ')}, ${L.countyLabel}`}
  schema={{
    type: 'Service',
    faq,
    breadcrumbs: crumbs,
    service: {
      name: `${S.title} in ${L.title}`,
      description,
      priceFrom: S.priceFrom,
      priceTo: S.priceTo,
    },
    areaServed: {
      name: `${L.title}, Virginia`,
      lat: L.geo.lat,
      lng: L.geo.lng,
      postalCode: L.zips[0],
    },
  }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="cs-hero">
    <div class="container">
      <p class="eyebrow">{L.countyLabel} · {L.zips.join(' · ')}</p>
      <h1>{S.title} in {L.title}, VA</h1>
      <p class="lede mt-5">
        Local {S.title.toLowerCase()} out of Chantilly for {L.title} homes and businesses.
        Published load-size pricing from ${S.priceFrom}. {L.responseTime}.
      </p>
      <div class="btn-row mt-6">
        <a href={phoneHref} class="btn btn-lg" data-track="call-city-service">
          <Icon name="phone" size={19} />
          {site.phone.display}
        </a>
        <a href={smsHref} class="btn btn-lg btn-ghost">Text a photo</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cs-grid">
      <div class="prose">
        <h2>{S.title} for {L.title} addresses</h2>
        <p>
          Dominion Haul Co handles {S.title.toLowerCase()} across {L.title} and the rest of{' '}
          {L.countyLabel}. You get a local crew on the phone, a firm price before we load,
          and the same published rates we post for every Northern Virginia city we serve.
        </p>
        <p>{S.lede}</p>
        <h3>What is included</h3>
        <ul>
          {S.includes.map((item) => <li>{item}</li>)}
        </ul>
        <h3>Neighborhoods we know in {L.title}</h3>
        <p>
          {L.areas.length
            ? `${L.areas.join(', ')} — and anywhere else inside ${L.title} ZIPs ${L.zips.join(', ')}.`
            : `Everywhere inside ${L.title} (${L.zips.join(', ')}).`}
        </p>
        <p>
          <a href={`/services/${svc.id}`}>Full ${S.title.toLowerCase()} details</a>
          {' · '}
          <a href={`/locations/${loc.id}`}>Everything we haul in {L.title}</a>
          {' · '}
          <a href="/pricing">Load-size pricing</a>
        </p>
      </div>

      <aside class="cs-rail">
        <div class="card">
          <h2>Price band in {L.title}</h2>
          <p class="cs-price">
            From <strong>${S.priceFrom}</strong>
            <span>to ${S.priceTo}</span>
          </p>
          <p class="muted">
            Volume pricing — stairs and long carries in {L.title} do not add a fee.
          </p>
          <a href="/pricing" class="link-arrow mt-4">
            See all load sizes <Icon name="arrow" size={16} class="arrow" />
          </a>
        </div>
        <div class="card">
          <h2>Book this job</h2>
          <QuoteForm preselect={svc.id} city={L.title} id={`quote-${loc.id}-${svc.id}`} />
        </div>
      </aside>
    </div>
  </section>

  <section class="section" data-band="dark">
    <div class="container">
      <FAQ items={faq} title={`${S.title} in ${L.title} — FAQ`} openFirst />
    </div>
  </section>

  {
    siblingCities.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <h2 class="cs-near">Also serving nearby</h2>
          <ul class="cs-sibs">
            {siblingCities.map((c) => (
              <li>
                <a href={`/locations/${c.id}/${svc.id}`}>
                  {S.title} in {c.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CTABand
    context={L.title}
    heading={`Need ${S.title.toLowerCase()} in ${L.title}?`}
    sub={`Text a photo from ${L.title}. We quote before we lift — usually under fifteen minutes when we are not mid-carry.`}
  />
</Base>

<style>
  .cs-hero {
    padding-block: var(--sp-8) var(--sp-7);
    background: var(--surface-sunk);
    border-bottom: 1px solid var(--line);
  }
  .cs-hero h1 {
    max-width: 16ch;
  }
  .cs-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  .cs-rail {
    display: grid;
    gap: var(--sp-4);
  }
  .cs-rail .card {
    padding: var(--sp-5);
  }
  .cs-rail h2 {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--sp-4);
  }
  .cs-price {
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .cs-price span {
    display: block;
    font-size: var(--step-0);
    color: var(--muted);
    margin-top: var(--sp-2);
    font-family: var(--font-sans);
    letter-spacing: 0;
  }
  .cs-near {
    font-size: var(--step-2);
    margin-bottom: var(--sp-5);
  }
  .cs-sibs {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
  }
  .cs-sibs a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .cs-sibs a:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
  }
  @media (min-width: 900px) {
    .cs-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--sp-8);
    }
    .cs-rail {
      position: sticky;
      top: calc(var(--header-h) + var(--sp-5));
    }
  }
</style>
