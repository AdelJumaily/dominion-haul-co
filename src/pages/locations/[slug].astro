---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import { buttonVariants } from '../../components/ui/button';
import { cn } from 'cn';
import { site, phoneHref, smsHref } from '../../config/site';
import { tiers, heavyMaterial, priceRule } from '../../config/pricing';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const all = await getCollection('locations');
const children = all
  .filter((l) => l.data.county === entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const siblings = all
  .filter((l) => l.data.county === d.county && l.id !== entry.id && d.county !== null)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const parent = d.county ? all.find((l) => l.id === d.county) : null;
const nearby = children.length > 0 ? children : siblings;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Service area', url: '/locations' },
  ...(parent ? [{ name: parent.data.title, url: `/locations/${parent.id}` }] : []),
  { name: d.title, url: `/locations/${entry.id}` },
];

const dateFmt = (v: Date) =>
  v.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const stats = [
  { label: 'Drive from Chantilly', value: d.driveTime },
  { label: 'Starting price', value: `${tiers[0].price} for one heavy item` },
  { label: 'ZIP codes', value: d.zips.join(' · ') },
];
---

<Base
  title={d.metaTitle}
  description={d.metaDescription}
  geoPlacename={`${d.title}, VA`}
  geoPosition={d.geo}
  ogImage="/images/logo.webp"
  schema={{
    type: 'WebPage',
    faq: d.faq,
    breadcrumbs: crumbs,
    service: {
      name: `Junk Removal in ${d.title}`,
      description: d.metaDescription,
    },
    areaServed: {
      name: `${d.title}, Virginia`,
      lat: d.geo.lat,
      lng: d.geo.lng,
    },
  }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">
        {d.kind === 'city' ? `${d.countyLabel} · ${d.zips.join(' · ')}` : 'Northern Virginia'}
      </p>
      <h1 class="mt-2 max-w-3xl font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
        Junk removal in {d.title}, VA
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">{d.lede}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={phoneHref} class={cn(buttonVariants(), 'h-11 px-5')} data-track="call-loc-hero">{site.phone.display}</a>
        <a href="#quote" class={cn(buttonVariants({ variant: 'outline' }), 'h-11 border-stone-300 bg-white px-5')}>Get a free quote</a>
      </div>
      <ul class="mt-10 grid list-none gap-4 sm:grid-cols-3">
        {
          stats.map((stat) => (
            <li class="rounded-2xl bg-white p-5 ring-1 ring-stone-200">
              <p class="text-sm font-semibold text-brand">{stat.label}</p>
              <p class="mt-2 font-heading text-lg font-extrabold leading-snug text-stone-900">{stat.value}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10 text-center">
      <p class="text-sm font-semibold text-brand">
        {d.kind === 'county' ? 'Towns and communities' : 'Neighborhoods'}
      </p>
      <ul class="mt-4 flex list-none flex-wrap justify-center gap-2">
        {d.areas.map((area) => (
          <li class="rounded-full bg-[#f4f7f5] px-3 py-1 text-sm font-medium text-stone-700">{area}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-14 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.8fr)]">
      <div class="rounded-2xl bg-white p-6 ring-1 ring-stone-200 sm:p-8">
        {
          d.accessNotes.length > 0 && (
            <div>
              <h2 class="font-heading text-2xl font-extrabold tracking-tight text-stone-900">Getting to you in {d.title}</h2>
              <ul class="mt-4 grid gap-3">
                {d.accessNotes.map((note) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-stone-700">
                    <span class="mt-0.5 text-brand" aria-hidden="true">✓</span>
                    {note}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="prose max-w-none text-stone-700 [&_a]:font-semibold [&_a]:text-brand [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:tracking-tight [&_h2]:text-stone-900 [&_h3]:font-heading [&_h3]:text-xl [&_h3]:font-extrabold [&_h3]:text-stone-900">
          <Content />
        </div>
      </div>

      <aside class="grid gap-4 lg:sticky lg:top-24">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
          <h2 class="font-heading text-xl font-extrabold text-stone-900">Prices in {d.title}</h2>
          <ul class="mt-4 grid gap-3">
            {
              tiers.map((t) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-stone-100 pb-3 last:border-0 last:pb-0">
                  <span class="text-sm text-stone-600">{t.name}</span>
                  <strong class="font-heading text-base font-extrabold text-stone-900">{t.price}</strong>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-stone-600">
            {heavyMaterial.note} Same rates everywhere, with no distance fee. <span class="font-semibold text-stone-900">{priceRule}</span>
          </p>
          <a href="/pricing" class="mt-4 inline-block text-sm font-semibold text-brand hover:underline">Full pricing</a>
        </div>
        <div class="rounded-2xl bg-brand p-6 text-white">
          <h2 class="font-heading text-xl font-extrabold">Book {d.title}</h2>
          <a href={phoneHref} class="mt-3 inline-block font-heading text-2xl font-extrabold hover:underline">{site.phone.display}</a>
          <a href={smsHref} class="mt-2 block text-sm font-semibold text-white/80 hover:text-white">Text a photo</a>
          <p class="mt-4 text-sm text-white/70">{site.hoursLabel}</p>
        </div>
      </aside>
    </div>
  </section>

  {
    d.recentJobs.length > 0 && (
      <section class="bg-white">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <h2 class="font-heading text-3xl font-extrabold tracking-tight text-stone-900">Recent jobs in {d.title}</h2>
          <ul class="mt-6 grid list-none gap-4 sm:grid-cols-2">
            {d.recentJobs.map((job) => (
              <li class="rounded-2xl bg-[#f4f7f5] p-5">
                <p class="font-heading text-lg font-extrabold text-stone-900">{job.what}</p>
                {(job.where || job.date) && (
                  <p class="mt-1 text-sm text-stone-600">
                    {[job.where, job.date ? dateFmt(job.date) : null].filter(Boolean).join(' · ')}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    (nearby.length > 0 || parent) && (
      <section class="bg-white">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <h2 class="text-center font-heading text-3xl font-extrabold tracking-tight text-stone-900">
            {children.length > 0 ? `Towns in ${d.title}` : `Also nearby in ${d.countyLabel}`}
          </h2>
          <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {nearby.map((l) => (
              <li>
                <a href={`/locations/${l.id}`} class="flex h-full flex-col rounded-2xl bg-[#f4f7f5] p-5 transition hover:-translate-y-0.5 hover:shadow-md">
                  <span class="font-heading text-lg font-extrabold text-stone-900">{l.data.title}</span>
                  <span class="mt-2 text-sm text-stone-600">{l.data.areas.slice(0, 3).join(' · ')}</span>
                </a>
              </li>
            ))}
            {parent && (
              <li>
                <a href={`/locations/${parent.id}`} class="flex h-full flex-col rounded-2xl bg-white p-5 ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:shadow-md">
                  <span class="font-heading text-lg font-extrabold text-stone-900">All of {parent.data.title}</span>
                  <span class="mt-2 text-sm text-stone-600">County overview</span>
                </a>
              </li>
            )}
          </ul>
        </div>
      </section>
    )
  }

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">What we haul in {d.title}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Every service, same crew</h2>
      <div class="mt-8">
        <ServiceGrid locationTitle={d.title} />
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <FAQ items={d.faq} title={`Junk removal in ${d.title}`} eyebrow={`${d.title} FAQ`} openFirst />
    </div>
  </section>

  <section class="bg-[#f4f7f5]" id="quote">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand">Free quote</p>
        <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Get a price for your {d.title} job</h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-stone-600">
          Send a couple of photos and we will come back with a number. No obligation.
        </p>
      </div>
      <div class="rounded-2xl bg-white p-5 ring-1 ring-stone-200 sm:p-6">
        <QuoteForm city={d.title} id={`quote-${entry.id}`} />
      </div>
    </div>
  </section>

  <CTABand context={d.title} heading={`Need something gone in ${d.title}?`} />
</Base>
