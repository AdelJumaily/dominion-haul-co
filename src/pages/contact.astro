---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { Card, CardHeader } from '../components/ui/card';
import { site, phoneHref, smsHref, cityState } from '../config/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Get a quote', url: '/contact' },
];

const methods = [
  { href: phoneHref, label: 'Call', value: site.phone.display, note: 'Straight to the owner.' },
  { href: smsHref, label: 'Text a photo', value: site.phone.display, note: 'A picture, then a price.' },
  { href: `mailto:${site.email}`, label: 'Email', value: site.email, note: 'Best for commercial and estate work.' },
];

const faq = [
  {
    q: 'How fast will you get back to me?',
    a: 'During business hours we get back to you the same day. Outside them, the next morning. If you need an answer right now, call. The phone is faster than the form and it rings to a person.',
  },
  {
    q: 'Do I have to be home for the quote?',
    a: 'No. A couple of photos is usually enough for a price, and a job can be booked and done without you there as long as we can get access. For anything inside the house we would rather someone was there.',
  },
  {
    q: 'Is the quote binding?',
    a: 'The on-site one is. We confirm the price out loud after looking at the actual job, before anything is loaded, and that is what you pay. A quote from photos is our best read on what we can see. If the reality is different, we tell you before we start, not after.',
  },
];
---

<Base
  title="Get a Quote | Call, Text or Send Photos | Dominion Haul"
  description="Get a junk removal quote in Northern Virginia. Call, text a photo, or use the form. No obligation. Based in Chantilly VA, fully insured. 571-477-7222."
  schema={{ type: 'ContactPage', faq, breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">Get a quote</p>
      <h1 class="mt-2 max-w-3xl font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
        Three ways to reach us. All of them reach a person.
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-stone-600">
        A photo of the pile is the quickest way to a price. No obligation.
      </p>

      <ul class="mt-10 grid list-none gap-4 md:grid-cols-3">
        {
          methods.map((m) => (
            <li>
              <a href={m.href} class="block h-full">
                <Card className="h-full shadow-none transition hover:-translate-y-0.5 hover:shadow-md">
                  <CardHeader>
                    <p class="text-sm font-semibold text-brand">{m.label}</p>
                    <p class="font-heading text-lg font-extrabold break-all text-stone-900">{m.value}</p>
                    <p class="text-sm text-stone-600">{m.note}</p>
                  </CardHeader>
                </Card>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand">The form</p>
        <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Tell us what you've got</h2>
        <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-stone-600">
          <li><span class="font-semibold text-stone-900">Photos help most.</span> One wide shot of the pile is enough.</li>
          <li><span class="font-semibold text-stone-900">Mention the access.</span> Basement, stairs, or a back yard changes the crew, not the price.</li>
          <li><span class="font-semibold text-stone-900">Say if it's urgent.</span> We'll tell you straight whether we can hit the day. No rush fee.</li>
        </ul>
        <dl class="mt-8 grid gap-4 text-sm sm:grid-cols-3 lg:grid-cols-1">
          <div>
            <dt class="font-semibold text-stone-900">Hours</dt>
            <dd class="text-stone-600">{site.hoursLabel}</dd>
          </div>
          <div>
            <dt class="font-semibold text-stone-900">Service area</dt>
            <dd class="text-stone-600">Fairfax, Loudoun, Prince William, and Arlington</dd>
          </div>
          <div>
            <dt class="font-semibold text-stone-900">Based in</dt>
            <dd class="text-stone-600">{cityState}</dd>
          </div>
        </dl>
      </div>
      <div class="rounded-2xl bg-[#f4f7f5] p-5 ring-1 ring-stone-200 sm:p-6">
        <QuoteForm id="quote-contact" />
      </div>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <FAQ items={faq} title="Before you send it" eyebrow="Questions" />
    </div>
  </section>

  <CTABand />
</Base>
