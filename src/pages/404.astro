---
import Base from '../layouts/Base.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from 'cn';
import { getCollection } from 'astro:content';
import { site, phoneHref } from '../config/site';
import { services } from '../config/services';

const counties = (await getCollection('locations'))
  .filter((l) => l.data.kind === 'county')
  .sort((a, b) => a.data.order - b.data.order);

const columns = [
  {
    title: 'Services',
    links: services.map((s) => ({ href: `/services/${s.id}`, label: s.title })),
  },
  {
    title: 'Service area',
    links: [
      ...counties.map((c) => ({ href: `/locations/${c.id}`, label: c.data.title })),
      { href: '/locations', label: 'All cities and towns' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/pricing', label: 'Pricing' },
      { href: '/commercial', label: 'Commercial' },
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Get a quote' },
    ],
  },
];
---

<Base
  title="Page not found | Dominion Haul"
  description="That page is gone. Here is where to find our services and our Northern Virginia service area."
  index={false}
>
  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <p class="text-sm font-semibold text-brand">404</p>
      <h1 class="mt-2 max-w-xl font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
        Already hauled that one away.
      </h1>
      <p class="mt-4 max-w-lg text-lg leading-relaxed text-stone-600">
        That page isn't here. Call {site.phone.display} if you need something hauled, or pick a page below.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={phoneHref} class={cn(buttonVariants(), 'h-11 px-5')}>{site.phone.display}</a>
        <a href="/" class={cn(buttonVariants({ variant: 'outline' }), 'h-11 border-stone-300 bg-white px-5')}>Back to home</a>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          columns.map((col) => (
            <div class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
              <h2 class="font-heading text-lg font-extrabold text-stone-900">{col.title}</h2>
              <ul class="mt-4 grid gap-2">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm font-medium text-stone-700 hover:text-brand">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
