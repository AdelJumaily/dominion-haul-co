---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Figure from '../../components/Figure.astro';
import { buttonVariants } from '../../components/ui/button';
import { cn } from 'cn';
import { site, phoneHref, smsHref } from '../../config/site';
import { services } from '../../config/services';
import { tiers, heavyMaterial, priceRule } from '../../config/pricing';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service: s } = Astro.props;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: s.title, url: `/services/${s.id}` },
];

const shortName: Record<string, string> = {
  'junk-removal': 'Household junk',
  'furniture-removal': 'Furniture',
  'appliance-removal': 'Appliances',
  'garage-basement-attic-cleanouts': 'Garage and attic',
  'estate-cleanouts': 'Estate cleanouts',
  'yard-waste-removal': 'Yard waste',
  'construction-debris-removal': 'Remodel debris',
};

const others = services.filter((o) => o.id !== s.id).sort((a, b) => a.order - b.order);
---

<Base
  title={s.metaTitle}
  description={s.metaDescription}
  ogImage="/images/logo.webp"
  schema={{
    type: 'WebPage',
    faq: s.faq,
    breadcrumbs: crumbs,
    service: { name: s.title, description: s.metaDescription },
  }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand">Chantilly, VA · Fully insured</p>
        <h1 class="mt-2 font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">{s.h1}</h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-stone-600">{s.short}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={phoneHref} class={cn(buttonVariants(), 'h-11 px-5')} data-track="call-service">{site.phone.display}</a>
          <a href="#quote" class={cn(buttonVariants({ variant: 'outline' }), 'h-11 border-stone-300 bg-white px-5')}>Get a price</a>
        </div>
        <p class="mt-4 text-sm text-stone-500">Or text a photo to {site.phone.display}.</p>
      </div>
      <Figure imageKey={s.image} priority ratio="4/3" sizes="(max-width: 1024px) 100vw, 45vw" class="shadow-lg" />
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">Price</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">What it costs</h2>
      <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          tiers.map((t) => (
            <li class="rounded-2xl bg-[#f4f7f5] p-5">
              <p class="text-sm font-semibold text-stone-500">{t.name}</p>
              <p class="mt-2 font-heading text-2xl font-extrabold tracking-tight text-stone-900">{t.price}</p>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{t.covers}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-stone-600">
        {heavyMaterial.note} <span class="font-semibold text-stone-900">{priceRule}</span>
      </p>
      <a href="/pricing" class="mt-4 inline-block text-sm font-semibold text-brand hover:underline">Full pricing</a>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-14 lg:grid-cols-2">
      <div class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-stone-900">What we take</h2>
        <ul class="mt-5 grid gap-3">
          {s.items.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-stone-700">
              <span class="mt-0.5 text-brand" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-stone-900">What's included</h2>
        <ul class="mt-5 grid gap-3">
          {s.includes.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-stone-700">
              <span class="mt-0.5 text-brand" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
        {
          s.notes && (
            <div class="mt-6 border-t border-stone-200 pt-5">
              <h3 class="font-heading text-base font-extrabold text-stone-900">Worth knowing</h3>
              <ul class="mt-3 grid gap-2">
                {s.notes.map((note) => <li class="text-sm leading-relaxed text-stone-600">{note}</li>)}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center">
      <h2 class="font-heading text-3xl font-extrabold tracking-tight text-stone-900">Where we do it</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-stone-600">
        Fairfax, Loudoun, Prince William, and Arlington. Same price everywhere.
      </p>
      <a href="/locations" class="mt-4 inline-block text-sm font-semibold text-brand hover:underline">See the towns we cover</a>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <FAQ items={s.faq} title={`${s.title} questions`} eyebrow="FAQ" openFirst />
    </div>
  </section>

  <section class="bg-white" id="quote">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand">Free quote</p>
        <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Get a price</h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-stone-600">
          Send a photo and a rough idea of what's going. We'll come back with a number.
        </p>
        <a href={phoneHref} class="mt-6 inline-block font-heading text-3xl font-extrabold text-brand hover:underline">{site.phone.display}</a>
        <a href={smsHref} class="mt-3 block text-sm font-semibold text-brand hover:underline">Text a photo</a>
      </div>
      <div class="rounded-2xl bg-[#f4f7f5] p-5 ring-1 ring-stone-200 sm:p-6">
        <QuoteForm preselect={s.id} id={`quote-${s.id}`} />
      </div>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-center font-heading text-3xl font-extrabold tracking-tight text-stone-900">We also do</h2>
      <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((o) => (
            <li>
              <a href={`/services/${o.id}`} class="flex h-full flex-col rounded-2xl bg-white p-5 ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="font-heading text-lg font-extrabold text-stone-900">{shortName[o.id] ?? o.title}</span>
                <span class="mt-2 text-sm leading-relaxed text-stone-600">{o.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABand />
</Base>
