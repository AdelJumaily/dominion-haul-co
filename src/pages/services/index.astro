---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { Card } from '../../components/ui/card';
import { buttonVariants } from '../../components/ui/button';
import { cn } from 'cn';
import { site, phoneHref } from '../../config/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
];

const cards = [
  {
    href: '/services/junk-removal',
    title: 'Household junk',
    line: 'Bags, boxes, mattresses, and the spare-room pile.',
    src: '/images/services/household.webp',
    alt: 'Trash bags, cardboard boxes, a mattress, and a bookshelf set out on a driveway',
  },
  {
    href: '/services/furniture-removal',
    title: 'Furniture',
    line: 'Couches, dressers, mattresses, and desks.',
    src: '/images/services/furniture.webp',
    alt: 'A sofa, a wooden dresser, and a mattress on a concrete driveway',
  },
  {
    href: '/services/appliance-removal',
    title: 'Appliances',
    line: 'Fridges, washers, dryers, and stoves.',
    src: '/images/services/appliances.webp',
    alt: 'A refrigerator, a washing machine, and a stove on a driveway',
  },
  {
    href: '/services/garage-basement-attic-cleanouts',
    title: 'Garage and attic',
    line: 'The whole space, cleared in one visit.',
    src: '/images/services/garage.webp',
    alt: 'An open garage packed with boxes, bins, tools, and a bicycle',
  },
  {
    href: '/services/estate-cleanouts',
    title: 'Estate cleanouts',
    line: 'A family home, cleared at your pace.',
    src: '/images/services/estate.webp',
    alt: 'A living room with stacked boxes, folded blankets, and a lamp',
  },
  {
    href: '/services/yard-waste-removal',
    title: 'Yard waste',
    line: 'Branches, brush, and bagged leaves.',
    src: '/images/services/yard.webp',
    alt: 'Cut branches, brush, and paper yard bags on a lawn',
  },
  {
    href: '/services/construction-debris-removal',
    title: 'Remodel debris',
    line: 'Drywall, cabinets, and flooring. No dumpster.',
    src: '/images/services/remodel.webp',
    alt: 'Broken drywall, wood trim, and a cabinet door piled on a driveway',
  },
];

const skip = [
  'Paint and solvents',
  'Pool chemicals',
  'Propane tanks',
  'Asbestos',
  'Medical waste',
  'Firearms',
  'Moving jobs',
  'Pianos',
  'Safes',
  'Hot tubs',
];
---

<Base
  title="Junk Removal Services | Dominion Haul, Chantilly VA"
  description="What Dominion Haul hauls: furniture, appliances, garage and basement cleanouts, estate cleanouts, yard waste and remodel debris. One heavy item from $165. Chantilly, VA."
  schema={{ type: 'CollectionPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-xl">
          <p class="text-sm font-semibold text-brand">Services</p>
          <h1 class="mt-2 font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
            What we haul
          </h1>
          <p class="mt-3 text-lg leading-relaxed text-stone-600">
            One item or a whole house. The price is set before we load.
          </p>
        </div>
        <a href={phoneHref} class={cn(buttonVariants(), 'h-11 shrink-0 px-5')}>
          Call {site.phone.display}
        </a>
      </div>

      <ul class="mt-10 grid list-none gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((card) => (
            <li>
              <a href={card.href} class="group block h-full">
                <Card className="h-full gap-0 overflow-hidden p-0 py-0 ring-stone-200 transition duration-200 group-hover:-translate-y-0.5 group-hover:shadow-lg">
                  <img
                    src={card.src}
                    alt={card.alt}
                    width="1152"
                    height="864"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full object-cover"
                  />
                  <div class="flex flex-1 flex-col gap-1 p-5">
                    <h2 class="font-heading text-lg font-extrabold text-stone-900 group-hover:text-brand">
                      {card.title}
                    </h2>
                    <p class="text-sm leading-relaxed text-stone-600">{card.line}</p>
                  </div>
                </Card>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-white px-5 py-4 ring-1 ring-stone-200">
        <p class="text-sm text-stone-600">
          One heavy item from <span class="font-semibold text-stone-900">$165</span>. Heavy material is quoted by weight.
        </p>
        <a href="/pricing" class="text-sm font-semibold text-brand hover:underline">See prices</a>
      </div>

      <div class="mt-5 rounded-2xl bg-white p-6 ring-1 ring-stone-200">
        <h2 class="font-heading text-lg font-extrabold text-stone-900">What we don't take</h2>
        <ul class="mt-4 flex list-none flex-wrap gap-2">
          {
            skip.map((item) => (
              <li class="rounded-full bg-stone-100 px-3 py-1 text-sm font-medium text-stone-700">{item}</li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-stone-500">
          Hazardous waste goes to the county drop-off. Ask and we'll point you to it.
        </p>
      </div>
    </div>
  </section>

  <CTABand heading="Tell us what's going" sub="Text a photo. We'll send a price." />
</Base>
