---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { site, phoneHref } from '../../config/site';
import { services } from '../../config/services';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
];

const cantTake = [
  'Paint, solvents, gasoline and oil',
  'Pool chemicals and other chemicals',
  'Propane tanks and pressurized tanks',
  'Asbestos',
  'Medical waste',
  'Firearms and ammunition',
];
---

<Base
  title="Junk Removal & Hauling Services | Dominion Haul"
  description="Furniture, appliances, treadmills, yard waste, cleanouts, and hauling for realtors and remodelers in Northern Virginia. See what we take."
  schema={{ type: 'CollectionPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="page-hero" data-band="dark">
    <div class="container">
      <p class="eyebrow">What we haul</p>
      <h1>Junk Removal and Hauling Services</h1>
      <p class="lede mt-4">
        One crew for everything from a single couch to a whole house. Every job is priced by how
        much space it takes in our truck, and the price is agreed before we load.
      </p>
      <nav class="jump" aria-label="Jump to a service">
        {services.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container svc-list">
      {
        services.map((s, i) => (
          <article id={s.id} class="svc">
            <div class="svc-head">
              <span class="svc-icon"><Icon name={s.icon} size={28} /></span>
              <div>
                <h2>{s.title}</h2>
                <p class="svc-short">{s.short}</p>
              </div>
            </div>
            <div class="svc-body">
              <ul class="svc-items">
                {s.items.map((item) => (
                  <li><Icon name="check" size={18} /> {item}</li>
                ))}
              </ul>
              {s.note && <p class="svc-note">{s.note}</p>}
              <div class="btn-row mt-5">
                <a href={phoneHref} class="btn"><Icon name="phone" size={18} /> {site.phone.display}</a>
                <a href="/contact" class="btn btn-ghost">Get a quote</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-sm" data-band="muted">
    <div class="container cant">
      <div>
        <p class="eyebrow">For safety and legal reasons</p>
        <h2>What We Can't Take</h2>
        <p class="mt-4 muted">
          Each Northern Virginia county runs a household hazardous waste drop-off. Ask us and
          we'll point you to the right one.
        </p>
      </div>
      <ul class="cant-list">
        {cantTake.map((c) => <li><Icon name="x" size={18} /> {c}</li>)}
      </ul>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .page-hero {
    background: var(--accent);
    padding-block: var(--sp-8);
  }
  .page-hero h1 {
    color: #fff;
  }
  .page-hero .lede {
    color: #dbe7e1;
    max-width: 60ch;
  }
  .jump {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .jump a {
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .jump a:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }

  .svc-list {
    display: grid;
    gap: var(--sp-5);
  }
  .svc {
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-6) var(--sp-5);
    background: #fff;
    border: 1px solid var(--line);
    border-left: 5px solid var(--accent);
    border-radius: var(--r-lg);
    scroll-margin-top: calc(var(--header-h) + var(--sp-4));
  }
  .svc:target {
    border-left-color: var(--gold);
    box-shadow: var(--shadow-md);
  }
  .svc-head {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }
  .svc-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-md);
    background: var(--accent);
    color: #fff;
  }
  .svc h2 {
    font-size: var(--step-3);
  }
  .svc-short {
    margin-top: var(--sp-2);
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .svc-items {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-2) var(--sp-5);
  }
  .svc-items li {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
  }
  .svc-items :global(svg) {
    flex: none;
    margin-top: 0.25em;
    color: var(--gold);
  }
  .svc-note {
    margin-top: var(--sp-4);
    font-style: italic;
    color: var(--muted);
  }
  @media (min-width: 640px) {
    .svc-items {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .svc {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--sp-7);
      padding: var(--sp-7);
    }
  }

  .cant {
    display: grid;
    gap: var(--sp-6);
  }
  .cant-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .cant-list li {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    font-weight: 600;
  }
  .cant-list :global(svg) {
    color: #b3412e;
  }
  @media (min-width: 800px) {
    .cant {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .cant-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
