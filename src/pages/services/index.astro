---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { site, phoneHref } from '../../config/site';
import { navServices } from '../../config/services';
import { tiers, heavyMaterial } from '../../config/pricing';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
];

const cantTake = [
  'Paint, solvents, gas and oil',
  'Pool chemicals',
  'Propane and pressurized tanks',
  'Asbestos',
  'Medical waste',
  'Firearms and ammunition',
];

const wontDo = ['Moving', 'Pianos', 'Safes', 'Hot tubs'];
---

<Base
  title="Junk Removal Services | Dominion Haul, Chantilly VA"
  description="What Dominion Haul hauls: furniture, appliances, garage and basement cleanouts, estate cleanouts, yard waste and remodel debris. One heavy item from $165. Chantilly, VA."
  schema={{ type: 'CollectionPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="page-hero" data-band="dark">
    <div class="container">
      <p class="eyebrow">What we haul</p>
      <h1>Our Services</h1>
      <p class="lede mt-4">
        One heavy item or a whole house. You point at what's going, we carry it out and
        haul it off. Price is set before anything goes on the truck.
      </p>
      <div class="btn-row mt-6">
        <a href={phoneHref} class="btn btn-gold btn-lg">
          <Icon name="phone" size={19} /> {site.phone.display}
        </a>
        <a href="/pricing" class="btn btn-ghost btn-lg">See prices</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="svc-cards">
        {
          navServices.map((s) => (
            <li>
              <a href={`/services/${s.id}`} class="svc-card">
                <span class="sc-icon"><Icon name={s.icon} size={24} /></span>
                <h2>{s.title}</h2>
                <p>{s.short}</p>
                <span class="sc-more">
                  See details &amp; price <Icon name="arrow" size={15} class="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-sm" data-band="muted">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pricing, short version</p>
        <h2>What things cost</h2>
      </div>
      <ul class="mini-prices">
        {
          tiers.map((t) => (
            <li>
              <span>{t.name}</span>
              <strong>{t.price}</strong>
            </li>
          ))
        }
      </ul>
      <p class="mini-note">{heavyMaterial.note}</p>
      <a href="/pricing" class="link-arrow mt-4">
        Full pricing <Icon name="arrow" size={15} class="arrow" />
      </a>
    </div>
  </section>

  <section class="section-sm">
    <div class="container cant">
      <div>
        <p class="eyebrow">Straight answers</p>
        <h2>What we can't take</h2>
        <p class="mt-4 muted">
          Hazardous material needs a household hazardous waste drop-off. Every county around
          here runs one. Ask us and we'll point you at it.
        </p>
        <h3 class="wont-head">And a few things we don't do</h3>
        <ul class="wont-list">
          {wontDo.map((w) => <li><Icon name="x" size={16} /> {w}</li>)}
        </ul>
      </div>
      <ul class="cant-list">
        {cantTake.map((c) => <li><Icon name="x" size={18} /> {c}</li>)}
      </ul>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .page-hero {
    background: var(--accent);
    padding-block: var(--sp-8);
  }
  .page-hero h1 {
    color: #fff;
  }
  .page-hero .lede {
    color: #dbe7e1;
    max-width: 54ch;
  }

  .svc-cards {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-5);
    background: #fff;
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: var(--ink);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .svc-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-top-color: var(--gold);
  }
  .sc-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--sp-2);
    border-radius: var(--r-md);
    background: var(--accent);
    color: #fff;
  }
  .svc-card h2 {
    font-size: var(--step-1);
  }
  .svc-card p {
    color: var(--muted);
    line-height: 1.5;
  }
  .sc-more {
    margin-top: auto;
    padding-top: var(--sp-4);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--accent-deep, var(--accent));
  }

  .mini-prices {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .mini-prices li {
    display: grid;
    gap: 2px;
    padding: var(--sp-4);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .mini-prices span {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
  }
  .mini-prices strong {
    font-size: var(--step-1);
    font-weight: 850;
    letter-spacing: -0.03em;
  }
  .mini-note {
    margin-top: var(--sp-4);
    font-size: 0.92rem;
    color: var(--muted);
  }

  .cant {
    display: grid;
    gap: var(--sp-6);
  }
  .cant-list,
  .wont-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .cant-list li,
  .wont-list li {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    font-weight: 600;
  }
  .cant-list :global(svg),
  .wont-list :global(svg) {
    color: #b3412e;
    flex: none;
  }
  .wont-head {
    margin-top: var(--sp-6);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--sp-3);
  }
  .wont-list {
    /* Wraps rather than forcing a single row — a column grid of max-content
       items overflows the viewport on a narrow phone. */
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-4);
  }
  @media (min-width: 800px) {
    .cant {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .cant-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
