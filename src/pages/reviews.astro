---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from 'cn';
import { site, phoneHref } from '../config/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Reviews', url: '/reviews' },
];

const profileUrl = site.links.GBP_PROFILE_URL;
const reviewUrl = site.links.GBP_REVIEW_URL;
---

<Base
  title="Reviews | Dominion Haul"
  description="Dominion Haul is a new junk removal company in Chantilly, VA. We don't have reviews yet and we won't post fake ones. Worked with us? Tell us how it went."
  schema={{ type: 'WebPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-2xl px-4 py-16 text-center">
      <p class="text-sm font-semibold text-brand">Reviews</p>
      <h1 class="mt-2 font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
        We don't have reviews yet.
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        Dominion Haul is new. We are not going to post made-up reviews to fill the space. When real customers leave them, they will be on our Google profile.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {
          profileUrl && (
            <a href={profileUrl} class={cn(buttonVariants(), 'h-11 px-5')} rel="noopener" target="_blank">
              See us on Google
            </a>
          )
        }
        <a href={phoneHref} class={cn(buttonVariants({ variant: 'outline' }), 'h-11 border-stone-300 bg-white px-5')}>
          {site.phone.display}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-2xl px-4 py-14 text-center">
      <h2 class="font-heading text-3xl font-extrabold tracking-tight text-stone-900">A review from you matters right now</h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        If we did a good job, thirty seconds changes our week. If we did not, tell us directly first. We would rather fix it.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {
          reviewUrl && (
            <a href={reviewUrl} class={cn(buttonVariants(), 'h-11 px-5')} rel="noopener" target="_blank">
              Leave a Google review
            </a>
          )
        }
        <a href={`mailto:${site.email}`} class={cn(buttonVariants({ variant: 'outline' }), 'h-11 border-stone-300 bg-white px-5')}>
          Email us
        </a>
      </div>
      {
        !reviewUrl && (
          <p class="mt-6 text-sm text-stone-600">
            Our Google review link is not live yet. Email
            <a href={`mailto:${site.email}`} class="font-semibold text-brand"> {site.email}</a>
            or text {site.phone.display}.
          </p>
        )
      }
    </div>
  </section>

  <CTABand />
</Base>
