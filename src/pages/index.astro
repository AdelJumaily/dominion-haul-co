---
import Base from '../layouts/Base.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import QuoteForm from '../components/QuoteForm.astro';
import JobGallery from '../components/JobGallery.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { site, phoneHref, smsHref, images } from '../config/site';
import { tiers, heavyMaterial, priceRule } from '../config/pricing';
import { getCollection } from 'astro:content';

const locations = await getCollection('locations');

const countyOrder = ['fairfax-county', 'loudoun-county', 'prince-william-county', 'arlington-county'];
const areaGroups = countyOrder
  .map((id) => locations.find((l) => l.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((county) => ({
    county,
    cities: locations
      .filter((l) => l.data.kind === 'city' && l.data.county === county.id)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }));

const steps = [
  {
    t: 'Send a photo or call',
    d: `Text a picture of what's going to ${site.phone.display}, or call and describe it. We'll give you a price.`,
  },
  {
    t: 'We confirm the price on site',
    d: 'When we show up, you get the final number before we lift anything. If the pile is smaller than it looked, the price comes down.',
  },
  {
    t: 'We haul it and sweep up',
    d: 'We carry it out from wherever it is, load the truck, and leave the space swept.',
  },
];

const whyUs = [
  {
    icon: 'phone',
    t: 'You talk to the person who shows up',
    d: "We're a local Chantilly company. The phone rings to the owner, not a dispatcher.",
  },
  {
    icon: 'tag',
    t: 'Our prices are on the site',
    d: 'A lot of companies make you call for a price. Ours are published, and the number is agreed before anything goes on the truck.',
  },
  {
    icon: 'truck',
    t: 'We do all the lifting',
    d: 'Stairs, basements, attics, back yards. You point, we carry.',
  },
  {
    icon: 'shield',
    t: 'Fully insured',
    d: 'We can send a certificate of insurance if your building or company needs one.',
  },
];

const homeFaq = [
  {
    q: 'How much does junk removal cost?',
    a: `We price by how much space your stuff takes up in the truck, not by the hour. One heavy item is ${tiers[0].price}. Half a truck is ${tiers[2].price.toLowerCase()}. A full truck is ${tiers[3].price.toLowerCase()}. ${heavyMaterial.items} are priced by weight instead and we quote that on site. ${priceRule}`,
  },
  {
    q: 'What do you take?',
    a: 'Most things from a house, garage or yard. Furniture, mattresses, appliances, treadmills and exercise equipment, electronics, boxes, yard waste, and debris from remodeling. If you are not sure about something, send a photo and ask.',
  },
  {
    q: "What won't you take?",
    a: 'No hazardous material: paint, solvents, gas, oil, pool chemicals, propane tanks, asbestos, medical waste. No firearms or ammunition. We also do not do moving, pianos, safes or hot tubs. Every county around here runs a household hazardous waste drop-off, and we can point you to yours.',
  },
  {
    q: 'How soon can you come?',
    a: 'Depends on the day and where you are. Call or text and we will tell you the soonest slot we can actually keep. We would rather give you a real time than a promise we miss.',
  },
  {
    q: 'Do I have to carry everything outside first?',
    a: 'No. That is the job. We carry it out from wherever it is, including basements, attics, upstairs bedrooms, garages and back yards.',
  },
  {
    q: 'What areas do you cover?',
    a: 'We are based in Chantilly and work across Fairfax, Loudoun, Prince William and Arlington counties. Same prices everywhere, with no distance fee.',
  },
  {
    q: 'You seem new. Why should I call you?',
    a: 'We are new, and we are not going to pretend otherwise. What that means for you is that we answer our own phone, we publish our prices, and we are trying to get this right because we need the work and the reviews. You are not a ticket number here.',
  },
];
---

<Base
  title="Junk Removal in Northern Virginia | Dominion Haul"
  description="Junk removal out of Chantilly VA. Furniture, appliances, cleanouts and remodel debris across Fairfax, Loudoun, Prince William and Arlington. Call or text 571-477-7222."
  schema={{ type: 'WebPage', faq: homeFaq }}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="hero" data-band="dark">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Based in Chantilly, VA &middot; Fully insured</p>
        <h1>Junk Removal in Northern Virginia</h1>
        <p class="hero-sub">
          Furniture, appliances, cleanouts and yard waste. You point at what's going. We
          carry it out and haul it off.
        </p>
        <div class="btn-row hero-btns">
          <a href={phoneHref} class="btn btn-gold btn-lg" data-track="call-hero">
            <Icon name="phone" size={20} /> Call {site.phone.display}
          </a>
          <a href="#quote" class="btn btn-ghost btn-lg">Get a price</a>
        </div>
        <ul class="hero-checks">
          <li><Icon name="check" size={18} /> Prices on the site</li>
          <li><Icon name="check" size={18} /> Final price before we load</li>
          <li><Icon name="check" size={18} /> We do the lifting</li>
        </ul>
      </div>
      <div class="hero-photo">
        <img
          src={images.truckLoad.src}
          alt={images.truckLoad.alt}
          width={images.truckLoad.width}
          height={images.truckLoad.height}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          sizes="(max-width: 960px) 100vw, 40vw"
        />
      </div>
    </div>
  </section>

  <!-- ══ AREA STRIP ════════════════════════════════════════════════════ -->
  <div class="area-strip">
    <div class="container">
      <strong>Fairfax</strong> &middot; <strong>Loudoun</strong> &middot;
      <strong>Prince William</strong> &middot; <strong>Arlington</strong>
    </div>
  </div>

  <!-- ══ PRICES ════════════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">No calling to find out</p>
        <h2>What it costs</h2>
      </div>
      <ul class="price-strip">
        {
          tiers.map((t) => (
            <li>
              <span class="ps-name">{t.name}</span>
              <strong class="ps-price">{t.price}</strong>
              <span class="ps-covers">{t.covers}</span>
            </li>
          ))
        }
      </ul>
      <p class="price-foot">
        {heavyMaterial.note} <strong>{priceRule}</strong>
      </p>
      <div class="btn-row center-btns mt-5">
        <a href="/pricing" class="btn btn-ghost">
          Full pricing <Icon name="arrow" size={17} class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══ SERVICES ══════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">What we haul</p>
        <h2>Our Services</h2>
        <p class="lede">One heavy item or a whole house.</p>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <!-- ══ HOW IT WORKS ══════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">Three steps</p>
        <h2>How It Works</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══ WHY US ════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container why">
      <div class="why-lead">
        <p class="eyebrow">Why us</p>
        <h2>We're New, and That's the Pitch</h2>
        <p class="lede mt-4">
          Dominion Haul started this year. One truck, out of Chantilly. We don't have a
          wall of reviews yet, so we're earning them one job at a time. Straight prices,
          straight answers, and we care what your place looks like when we pull away.
        </p>
        <a href="/about" class="link-arrow mt-5">About us <Icon name="arrow" size={17} class="arrow" /></a>
      </div>
      <ul class="why-list">
        {
          whyUs.map((w) => (
            <li>
              <span class="why-icon"><Icon name={w.icon} size={22} /></span>
              <div>
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══ COMMERCIAL ════════════════════════════════════════════════════ -->
  <section class="section-sm partner" data-band="dark">
    <div class="container partner-inner">
      <div>
        <p class="eyebrow">For businesses</p>
        <h2>Work With Us</h2>
        <p class="lede mt-4">
          Property managers, realtors, remodelers and HOAs: one number to call, and photos
          of the job for your records.
        </p>
      </div>
      <div class="btn-row">
        <a href="/commercial" class="btn btn-gold btn-lg">
          How it works <Icon name="arrow" size={18} class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══ PHOTOS ════════════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">The kind of thing we clear</p>
        <h2>What a Load Looks Like</h2>
      </div>
      <JobGallery />
    </div>
  </section>

  <!-- ══ SERVICE AREA ══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">Where we work</p>
        <h2>Service Area</h2>
        <p class="lede">
          Our truck is based in Chantilly. Don't see your town? If you're in one of these
          four counties, call and ask.
        </p>
      </div>
      <div class="areas">
        {
          areaGroups.map(({ county, cities }) => (
            <div class="area-col">
              <h3><a href={`/locations/${county.id}`}>{county.data.title}</a></h3>
              <ul>
                {cities.map((c) => (
                  <li><a href={`/locations/${c.id}`}>{c.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ FAQ ═══════════════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <FAQ items={homeFaq} title="Common Questions" openFirst />
    </div>
  </section>

  <!-- ══ QUOTE ═════════════════════════════════════════════════════════ -->
  <section class="section" id="quote">
    <div class="container quote">
      <div class="quote-copy">
        <p class="eyebrow">Free, no obligation</p>
        <h2>Get a Price</h2>
        <p class="lede mt-4">
          Send the details and a photo or two. We'll come back with a number.
        </p>
        <div class="quote-direct">
          <a href={phoneHref} class="quote-phone"><Icon name="phone" size={22} /> {site.phone.display}</a>
          <a href={smsHref} class="link-arrow">Or text us a photo <Icon name="arrow" size={16} class="arrow" /></a>
          <a href={`mailto:${site.email}`} class="link-arrow">{site.email}</a>
          <p class="quote-hours"><Icon name="clock" size={15} /> {site.hoursLabel}</p>
        </div>
      </div>
      <div class="quote-card">
        <QuoteForm id="quote-home" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background: var(--accent);
    color: #fff;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }
  .hero-inner {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.6rem, 1.6rem + 4.2vw, 4.6rem);
  }
  .hero-sub {
    margin-top: var(--sp-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: #dbe7e1;
    max-width: 44ch;
  }
  .hero-btns {
    margin-top: var(--sp-6);
  }
  .hero-checks {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    font-weight: 600;
  }
  .hero-checks li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .hero-checks :global(svg) {
    color: var(--gold);
  }
  .hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
    border: 4px solid var(--gold);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--sp-8);
    }
  }

  .area-strip {
    background: var(--gold);
    color: var(--ink);
    text-align: center;
    padding-block: 0.8rem;
    font-size: 1.02rem;
  }

  .center-head {
    text-align: center;
    margin-inline: auto;
    max-width: 52ch;
  }
  .center-head .lede {
    margin-inline: auto;
  }
  .center-btns {
    justify-content: center;
  }

  /* Price strip */
  .price-strip {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .price-strip li {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-5);
    background: #fff;
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    border-radius: var(--r-lg);
  }
  .ps-name {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ps-price {
    font-size: var(--step-2);
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .ps-covers {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .price-foot {
    margin-top: var(--sp-5);
    text-align: center;
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 70ch;
    margin-inline: auto;
  }
  .price-foot strong {
    color: var(--ink);
  }
  @media (min-width: 620px) {
    .price-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .price-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Steps */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
  }
  .steps li {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--sp-6) var(--sp-5);
    text-align: center;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto var(--sp-4);
    border-radius: 50%;
    background: var(--accent);
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
  }
  .steps p {
    margin-top: var(--sp-3);
    color: var(--muted);
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Why */
  .why {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  .why-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
  }
  .why-list li {
    display: flex;
    gap: var(--sp-4);
  }
  .why-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    color: var(--accent);
  }
  .why-list p {
    margin-top: var(--sp-1);
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .why {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--sp-8);
      align-items: center;
    }
  }

  /* Partner band */
  .partner {
    background: var(--ink);
  }
  .partner-inner {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }
  .partner h2 {
    color: #fff;
  }
  .partner .lede {
    color: #c5d3cc;
    max-width: 56ch;
  }
  @media (min-width: 900px) {
    .partner-inner {
      grid-template-columns: 1fr auto;
    }
  }

  /* Areas */
  .areas {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .area-col {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
  }
  .area-col h3 a {
    color: var(--accent);
    text-decoration: none;
  }
  .area-col h3 a:hover {
    color: var(--gold);
  }
  .area-col ul {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-3);
    display: grid;
    gap: var(--sp-2);
  }
  .area-col li a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .area-col li a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  /* Quote */
  .quote {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  .quote-direct {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }
  .quote-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
    text-decoration: none;
  }
  .quote-hours {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.86rem;
    color: var(--muted);
  }
  .quote-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 960px) {
    .quote {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--sp-8);
    }
  }
</style>
