---
import Base from '../layouts/Base.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQ from '../components/FAQ.astro';
import { site, phoneHref, smsHref, images } from '../config/site';
import { tiers, heavyMaterial, priceRule } from '../config/pricing';
import { getCollection } from 'astro:content';
import { buttonVariants } from '../components/ui/button';
import { cn } from 'cn';
import { Badge } from '../components/ui/badge';
import { Card, CardContent, CardHeader } from '../components/ui/card';

const locations = await getCollection('locations');

const countyOrder = ['fairfax-county', 'loudoun-county', 'prince-william-county', 'arlington-county'];
const areaGroups = countyOrder
  .map((id) => locations.find((l) => l.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((county) => ({
    county,
    cities: locations
      .filter((l) => l.data.kind === 'city' && l.data.county === county.id)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }));

const steps = [
  {
    t: 'Send a photo or call',
    d: `Text a picture of what's going to ${site.phone.display}, or call and describe it. We'll give you a price.`,
  },
  {
    t: 'We confirm the price on site',
    d: 'When we show up, you get the final number before we lift anything. If the pile is smaller than it looked, the price comes down.',
  },
  {
    t: 'We haul it and sweep up',
    d: 'We carry it out from wherever it is, load the truck, and leave the space swept.',
  },
];

const points = [
  { t: 'Prices on the site', d: 'You can see the range before you call. The number is agreed before anything goes on the truck.' },
  { t: 'We do the lifting', d: 'Stairs, basements, attics, back yards. You point, we carry.' },
  { t: 'You talk to us', d: 'Local company out of Chantilly. The phone rings to the owner, not a dispatcher.' },
  { t: 'Fully insured', d: 'We can send a certificate of insurance if your building or company needs one.' },
];

const homeFaq = [
  {
    q: 'How much does junk removal cost?',
    a: `We price by how much space your stuff takes up in the truck, not by the hour. One heavy item is ${tiers[0].price}. Half a truck is ${tiers[2].price.toLowerCase()}. A full truck is ${tiers[3].price.toLowerCase()}. ${heavyMaterial.items} are priced by weight instead and we quote that on site. ${priceRule}`,
  },
  {
    q: 'What do you take?',
    a: 'Most things from a house, garage or yard. Furniture, mattresses, appliances, treadmills and exercise equipment, electronics, boxes, yard waste, and debris from remodeling. If you are not sure about something, send a photo and ask.',
  },
  {
    q: "What won't you take?",
    a: 'No hazardous material: paint, solvents, gas, oil, pool chemicals, propane tanks, asbestos, medical waste. No firearms or ammunition. We also do not do moving, pianos, safes or hot tubs. Every county around here runs a household hazardous waste drop-off, and we can point you to yours.',
  },
  {
    q: 'How soon can you come?',
    a: 'Depends on the day and where you are. Call or text and we will tell you the soonest slot we can actually keep. We would rather give you a real time than a promise we miss.',
  },
  {
    q: 'Do I have to carry everything outside first?',
    a: 'No. That is the job. We carry it out from wherever it is, including basements, attics, upstairs bedrooms, garages and back yards.',
  },
  {
    q: 'What areas do you cover?',
    a: 'We are based in Chantilly and work across Fairfax, Loudoun, Prince William and Arlington counties. Same prices everywhere, with no distance fee.',
  },
  {
    q: 'You seem new. Why should I call you?',
    a: 'We are new, and we are not going to pretend otherwise. What that means for you is that we answer our own phone, we publish our prices, and we are trying to get this right because we need the work and the reviews. You are not a ticket number here.',
  },
];

const hero = images.garageRenovation;
---

<Base
  title="Junk Removal in Northern Virginia | Dominion Haul"
  description="Junk removal out of Chantilly VA. Furniture, appliances, cleanouts and remodel debris across Fairfax, Loudoun, Prince William and Arlington. Call or text 571-477-7222."
  schema={{ type: 'WebPage', faq: homeFaq }}
>
  <section class="bg-[#f4f7f5]">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 md:grid-cols-2 md:py-20">
      <div>
        <p class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">
          <span class="inline-block h-2 w-2 rounded-full bg-brand"></span>
          Chantilly, VA · Fairfax, Loudoun, Prince William, Arlington
        </p>
        <h1 class="font-heading text-5xl font-extrabold leading-[0.95] tracking-tight text-stone-900 md:text-6xl">
          Got junk? We'll take it away.
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-stone-600">
          Furniture, appliances, cleanouts and remodel debris. You point at what's going. We carry it out, and we confirm the price before we load.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={phoneHref} data-track="call-hero" class={cn(buttonVariants(), "h-12 px-6 text-base")}>Call {site.phone.display}</a>
          <a href="#quote" class={cn(buttonVariants({ variant: "outline" }), "h-12 border-stone-300 bg-white px-6 text-base")}>Get a price</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-2xl shadow-xl">
        <img
          src={hero.src}
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-stone-200 bg-white">
    <ul class="mx-auto grid max-w-7xl list-none gap-4 p-4 sm:grid-cols-2 lg:grid-cols-4 lg:py-8">
      {
        points.map((p) => (
          <li>
            <Card className="h-full border-0 shadow-none ring-0">
              <CardHeader>
                <h2 class="font-heading text-lg font-extrabold text-stone-900">{p.t}</h2>
                <p class="text-sm leading-relaxed text-stone-600">{p.d}</p>
              </CardHeader>
            </Card>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-brand text-white">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-white/70">What we haul</p>
          <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-white md:text-4xl">Complete junk removal</h2>
        </div>
        <a href="/services" class={cn(buttonVariants(), "h-10 bg-white px-4 text-brand hover:bg-white/90")}>View all services</a>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <p class="text-sm font-semibold text-brand">How it works</p>
      <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Simple junk removal process</h2>
      <ol class="mt-8 grid list-none gap-4 p-0 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li>
              <Card className="h-full">
                <CardHeader>
                  <Badge className="mb-2 h-7 w-7 rounded-full p-0">{i + 1}</Badge>
                  <h3 class="font-heading text-xl font-extrabold text-stone-900">{s.t}</h3>
                </CardHeader>
                <CardContent>
                  <p class="text-sm leading-relaxed text-stone-600">{s.d}</p>
                </CardContent>
              </Card>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-brand">Published prices</p>
          <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">What it costs</h2>
        </div>
        <a href="/pricing" class="text-sm font-semibold text-brand hover:underline">Full pricing</a>
      </div>
      <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {
          tiers.map((t) => (
            <li>
              <Card className="h-full">
                <CardHeader>
                  {t.popular && <Badge variant="secondary" className="mb-2 w-fit">Most booked</Badge>}
                  <p class="text-sm font-medium text-stone-500">{t.name}</p>
                  <p class="font-heading text-3xl font-extrabold tracking-tight text-brand">{t.price}</p>
                </CardHeader>
                <CardContent>
                  <p class="text-sm leading-relaxed text-stone-600">{t.covers}</p>
                </CardContent>
              </Card>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-stone-600">
        {heavyMaterial.note} {priceRule}
      </p>
    </div>
  </section>

  <section class="bg-brand text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 md:grid-cols-2">
      <div class="overflow-hidden rounded-2xl">
        <img
          src={images.constructionYard.src}
          alt={images.constructionYard.alt}
          width={images.constructionYard.width}
          height={images.constructionYard.height}
          loading="lazy"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
      <div>
        <p class="text-sm font-semibold text-white/70">About us</p>
        <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-white md:text-4xl">Your local junk removal crew</h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-white/80">
          Dominion Haul started this year. One truck, out of Chantilly. We don't have a wall of reviews yet, so we're earning them one job at a time. Straight prices, and we care what your place looks like when we pull away.
        </p>
        <a href="/about" class={cn(buttonVariants(), "mt-6 h-11 bg-white px-5 text-brand hover:bg-white/90")}>Learn more about us</a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <p class="text-sm font-semibold text-brand">Where we work</p>
      <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Service area</h2>
      <p class="mt-3 max-w-xl text-stone-600">Four counties. Same price in every one of them.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          areaGroups.map(({ county }) => (
            <a href={`/locations/${county.id}`} class="group block">
              <Card className="h-full transition group-hover:-translate-y-0.5 group-hover:shadow-md">
                <CardHeader>
                  <h3 class="font-heading text-lg font-extrabold text-stone-900 group-hover:text-brand">
                    {county.data.title}
                  </h3>
                  <p class="text-sm text-stone-500">View towns</p>
                </CardHeader>
              </Card>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <FAQ items={homeFaq} title="Common questions" openFirst />
    </div>
  </section>

  <section class="bg-white" id="quote">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 py-16 md:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-sm font-semibold text-brand">Free, no obligation</p>
        <h2 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Get a price</h2>
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          Send the details and a photo or two. We'll come back with a number.
        </p>
        <div class="mt-6 grid gap-2">
          <a href={phoneHref} class="font-heading text-3xl font-extrabold text-brand hover:underline">{site.phone.display}</a>
          <a href={smsHref} class="text-sm font-semibold text-stone-800 hover:text-brand hover:underline">Or text us a photo</a>
          <a href={`mailto:${site.email}`} class="text-sm text-stone-600 hover:text-brand hover:underline">{site.email}</a>
          <p class="text-sm text-stone-500">{site.hoursLabel}</p>
        </div>
      </div>
      <Card className="p-2">
        <CardContent className="pt-4">
          <QuoteForm id="quote-home" />
        </CardContent>
      </Card>
    </div>
  </section>
</Base>
