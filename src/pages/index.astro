---
import Base from '../layouts/Base.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import QuoteForm from '../components/QuoteForm.astro';
import JobGallery from '../components/JobGallery.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { site, phoneHref, smsHref } from '../config/site';
import { getCollection } from 'astro:content';

const locations = await getCollection('locations');
const hasReviews = (await getCollection('testimonials')).some((r) => r.data.verified);

const countyOrder = ['fairfax-county', 'loudoun-county', 'prince-william-county', 'arlington-county'];
const areaGroups = countyOrder
  .map((id) => locations.find((l) => l.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((county) => ({
    county,
    cities: locations
      .filter((l) => l.data.kind === 'city' && l.data.county === county.id)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }));

const steps = [
  {
    t: 'Send a photo or call',
    d: `Text a picture of what's going to ${site.phone.display}, or call and describe it. We'll give you a price range.`,
  },
  {
    t: 'We confirm the price on site',
    d: 'When we arrive, we give you the final price before we lift anything. No surprises.',
  },
  {
    t: 'We haul it and sweep up',
    d: 'We carry everything out from wherever it is, load the truck, and leave the space swept.',
  },
];

const whyUs = [
  {
    icon: 'phone',
    t: 'You talk to the person who shows up',
    d: 'We are a local Chantilly company, not a national call center.',
  },
  {
    icon: 'tag',
    t: 'Price agreed before loading',
    d: 'You know exactly what you are paying before anything goes on the truck.',
  },
  {
    icon: 'truck',
    t: 'We do all the heavy lifting',
    d: 'Stairs, basements, attics and backyards. You just point.',
  },
  {
    icon: 'shield',
    t: 'Insured',
    d: 'Certificates of insurance available for buildings and commercial clients.',
  },
];

const homeFaq = [
  {
    q: 'How much does junk removal cost?',
    a: `We price by how much space your items take up in our truck, not by the hour. A single item costs much less than a full truckload. Text a photo to ${site.phone.display} and we'll send you a price range. When we arrive, we confirm the final price before loading anything.`,
  },
  {
    q: 'What items do you take?',
    a: 'Most things from a home, garage, or yard: furniture, mattresses, appliances, treadmills and exercise equipment, electronics, boxes and clutter, yard waste, and debris from small remodeling projects. If you are unsure about an item, send us a photo and ask.',
  },
  {
    q: "What items can't you take?",
    a: 'We cannot take hazardous materials, including paint, solvents, gasoline, oil, pool chemicals, propane tanks, asbestos, and medical waste. We also cannot take firearms or ammunition. Each Northern Virginia county runs a household hazardous waste drop-off, and we can point you to the right one.',
  },
  {
    q: 'How does scheduling work? Can you come today?',
    a: 'Call or text to tell us what you need removed and when. Same-day or next-day pickup is often possible when our schedule allows, especially if you reach out early in the day.',
  },
  {
    q: 'Do I have to carry everything outside first?',
    a: 'No. We carry items out from wherever they are, including basements, attics, upstairs bedrooms, garages, and backyards. Just show us what is going.',
  },
  {
    q: 'What areas do you serve?',
    a: 'We are based in Chantilly and serve Fairfax, Loudoun, Prince William, and Arlington counties, including Fairfax, Chantilly, Centreville, Herndon, Reston, Vienna, Ashburn, Leesburg, Manassas, Woodbridge, and Arlington.',
  },
];
---

<Base
  title="Junk Removal Northern Virginia | Dominion Haul"
  description="Dominion Haul removes furniture, appliances, and household junk across Fairfax, Loudoun, Prince William & Arlington. Call or text 571-477-7222."
  schema={{ type: 'WebPage', faq: homeFaq }}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="hero" data-band="dark">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Local &middot; Based in Chantilly, VA</p>
        <h1>Junk Removal and Hauling in Northern Virginia</h1>
        <p class="hero-sub">
          Furniture, appliances, treadmills, yard waste and full cleanouts. You point to what's
          going. We lift it, load it, and haul it away.
        </p>
        <div class="btn-row hero-btns">
          <a href={phoneHref} class="btn btn-gold btn-lg" data-track="call-hero">
            <Icon name="phone" size={20} /> Call {site.phone.display}
          </a>
          <a href="#quote" class="btn btn-ghost btn-lg">Get a Free Quote</a>
        </div>
        <ul class="hero-checks">
          <li><Icon name="check" size={18} /> Price agreed before we load</li>
          <li><Icon name="check" size={18} /> We do all the lifting</li>
          <li><Icon name="check" size={18} /> Insured</li>
        </ul>
      </div>
      <div class="hero-photo">
        <img
          src="/images/jobs/truck-load.png"
          alt="Dominion Haul truck loaded with household junk from a Northern Virginia pickup"
          width="900"
          height="900"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ AREA STRIP ════════════════════════════════════════════════════ -->
  <div class="area-strip">
    <div class="container">
      Serving <strong>Fairfax</strong> &middot; <strong>Loudoun</strong> &middot;
      <strong>Prince William</strong> &middot; <strong>Arlington</strong> counties
    </div>
  </div>

  <!-- ══ SERVICES ══════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">What we haul</p>
        <h2>Our Services</h2>
        <p class="lede">From a single couch to a whole house. If it's junk, we can probably take it.</p>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <!-- ══ HOW IT WORKS ══════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">Simple and upfront</p>
        <h2>How It Works</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══ WHY US ════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container why">
      <div class="why-lead">
        <p class="eyebrow">Why Dominion Haul</p>
        <h2>A Local Crew You Can Actually Reach</h2>
        <p class="lede mt-4">
          We're a new, local company building our name one job at a time. That means straight
          answers, fair prices, and a crew that cares how your place looks when we leave.
        </p>
        <a href="/about" class="link-arrow mt-5">About us <Icon name="arrow" size={17} class="arrow" /></a>
      </div>
      <ul class="why-list">
        {
          whyUs.map((w) => (
            <li>
              <span class="why-icon"><Icon name={w.icon} size={22} /></span>
              <div>
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══ COMMERCIAL PARTNERS ═══════════════════════════════════════════ -->
  <section class="section-sm partner" data-band="dark">
    <div class="container partner-inner">
      <div>
        <p class="eyebrow">For businesses</p>
        <h2>Become a Commercial Partner</h2>
        <p class="lede mt-4">
          Property managers, realtors, remodelers and HOAs: add Dominion Haul to your trusted
          vendor list. One contact, priority scheduling, and photos of every job for your
          records.
        </p>
      </div>
      <div class="btn-row">
        <a href="/commercial" class="btn btn-gold btn-lg">
          Partner With Us <Icon name="arrow" size={18} class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══ RECENT JOBS ═══════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">Real jobs, real photos</p>
        <h2>Recent Work</h2>
      </div>
      <JobGallery />
    </div>
  </section>

  {hasReviews && (
    <section class="section">
      <div class="container">
        <div class="section-head center-head">
          <p class="eyebrow">Reviews</p>
          <h2>What Customers Say</h2>
        </div>
        <Testimonials limit={3} featuredOnly />
      </div>
    </section>
  )}

  <!-- ══ SERVICE AREA ══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <p class="eyebrow">Where we work</p>
        <h2>Service Area</h2>
        <p class="lede">
          Our truck is based in Chantilly. Don't see your town? If you're in one of these four
          counties, call us. The answer is almost always yes.
        </p>
      </div>
      <div class="areas">
        {
          areaGroups.map(({ county, cities }) => (
            <div class="area-col">
              <h3><a href={`/locations/${county.id}`}>{county.data.title}</a></h3>
              <ul>
                {cities.map((c) => (
                  <li><a href={`/locations/${c.id}`}>{c.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ FAQ ═══════════════════════════════════════════════════════════ -->
  <section class="section" data-band="muted">
    <div class="container">
      <FAQ items={homeFaq} title="Common Questions" openFirst />
    </div>
  </section>

  <!-- ══ QUOTE ═════════════════════════════════════════════════════════ -->
  <section class="section" id="quote">
    <div class="container quote">
      <div class="quote-copy">
        <p class="eyebrow">Free, no obligation</p>
        <h2>Get a Free Quote</h2>
        <p class="lede mt-4">
          Send us the details and a photo or two. We'll get back to you with a price range.
        </p>
        <div class="quote-direct">
          <a href={phoneHref} class="quote-phone"><Icon name="phone" size={22} /> {site.phone.display}</a>
          <a href={smsHref} class="link-arrow">Or text us a photo <Icon name="arrow" size={16} class="arrow" /></a>
          <a href={`mailto:${site.email}`} class="link-arrow">{site.email}</a>
        </div>
      </div>
      <div class="quote-card">
        <QuoteForm id="quote-home" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background: var(--accent);
    color: #fff;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }
  .hero-inner {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.6rem, 1.6rem + 4.2vw, 4.6rem);
  }
  .hero-sub {
    margin-top: var(--sp-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: #dbe7e1;
    max-width: 46ch;
  }
  .hero-btns {
    margin-top: var(--sp-6);
  }
  .hero-checks {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    font-weight: 600;
  }
  .hero-checks li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .hero-checks :global(svg) {
    color: var(--gold);
  }
  .hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
    border: 4px solid var(--gold);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--sp-8);
    }
  }

  .area-strip {
    background: var(--gold);
    color: var(--ink);
    text-align: center;
    padding-block: 0.8rem;
    font-size: 1.02rem;
  }

  .center-head {
    text-align: center;
    margin-inline: auto;
    max-width: 52ch;
  }
  .center-head .lede {
    margin-inline: auto;
  }

  /* Steps */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
  }
  .steps li {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--sp-6) var(--sp-5);
    text-align: center;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto var(--sp-4);
    border-radius: 50%;
    background: var(--accent);
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
  }
  .steps p {
    margin-top: var(--sp-3);
    color: var(--muted);
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Why */
  .why {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  .why-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
  }
  .why-list li {
    display: flex;
    gap: var(--sp-4);
  }
  .why-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    color: var(--accent);
  }
  .why-list p {
    margin-top: var(--sp-1);
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .why {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--sp-8);
      align-items: center;
    }
  }

  /* Partner band */
  .partner {
    background: var(--ink);
  }
  .partner-inner {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }
  .partner h2 {
    color: #fff;
  }
  .partner .lede {
    color: #c5d3cc;
    max-width: 56ch;
  }
  @media (min-width: 900px) {
    .partner-inner {
      grid-template-columns: 1fr auto;
    }
  }

  /* Areas */
  .areas {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .area-col {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
  }
  .area-col h3 a {
    color: var(--accent);
    text-decoration: none;
  }
  .area-col h3 a:hover {
    color: var(--gold);
  }
  .area-col ul {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-3);
    display: grid;
    gap: var(--sp-2);
  }
  .area-col li a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .area-col li a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  /* Quote */
  .quote {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  .quote-direct {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }
  .quote-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
    text-decoration: none;
  }
  .quote-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 960px) {
    .quote {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--sp-8);
    }
  }
</style>
