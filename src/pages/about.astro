---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BrandMark from '../components/BrandMark.astro';
import { site, phoneHref, images } from '../config/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' },
];

const checks = [
  'Published prices',
  'Price before we load',
  'We do the lifting',
  'No stair fees',
  'Fully insured',
  'No dumpster to rent',
  'You talk to us',
  'Based in Chantilly',
];

const hero = images.garageRenovation;
---

<Base
  title="About Dominion Haul | Junk Removal in Chantilly, VA"
  description="Dominion Haul is a new junk removal company based in Chantilly, Virginia. One truck, published prices, price confirmed before we load."
  schema={{ type: 'AboutPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-5xl px-4 pb-16 pt-10">
      <div class="flex flex-col items-center text-center">
        <h1 class="sr-only">About Dominion Haul</h1>
        <BrandMark size="lockup" href={false} />
        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-semibold">
          <a href={phoneHref} class="text-brand hover:underline">Call {site.phone.display}</a>
          <a href="/contact" class="inline-flex items-center gap-1 text-brand hover:underline">
            Get a quote <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <img
        src={hero.src}
        alt={hero.alt}
        width={hero.width}
        height={hero.height}
        class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover shadow-xl ring-1 ring-stone-200"
      />

      <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-16">
        <div>
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-stone-900">Overview</h2>
          <p class="mt-4 leading-relaxed text-stone-600">
            Dominion Haul is a new junk removal company out of Chantilly. One truck. We publish the price, and we confirm it in the driveway before anything goes on the truck.
          </p>
          <ul class="mt-8 grid list-none gap-3 sm:grid-cols-2">
            {
              checks.map((item) => (
                <li class="flex items-center gap-2.5 text-sm font-medium text-stone-800">
                  <span class="grid size-5 shrink-0 place-items-center rounded-full bg-brand text-white">
                    <svg viewBox="0 0 16 16" class="size-3" fill="none" aria-hidden="true">
                      <path d="M3.5 8.2 6.4 11l6.1-6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="grid gap-10">
          <div>
            <h2 class="font-heading text-2xl font-extrabold tracking-tight text-stone-900">Background</h2>
            <p class="mt-4 leading-relaxed text-stone-600">
              We're new, and we say so. There is one truck, and the phone rings to the people who show up. We haul across Fairfax, Loudoun, Prince William, and Arlington.
            </p>
          </div>
          <div>
            <h2 class="font-heading text-2xl font-extrabold tracking-tight text-stone-900">How a job goes</h2>
            <p class="mt-4 leading-relaxed text-stone-600">
              Call or text a photo. We price the load by how much of the truck it fills. If the pile is smaller when we arrive, the price comes down. Then we carry it out.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
