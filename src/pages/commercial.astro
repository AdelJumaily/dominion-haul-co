---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Card, CardHeader, CardContent } from '../components/ui/card';
import { buttonVariants } from '../components/ui/button';
import { cn } from 'cn';
import { site, phoneHref, images } from '../config/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Commercial', url: '/commercial' },
];

const work = [
  { t: 'Commercial junk', d: 'Offices, retail, warehouses, and tenant turnovers. Furniture, fixtures, and the pile left after a move-out.' },
  { t: 'C&D debris', d: 'Drywall, lumber, flooring, roofing, concrete, and the rest of a tear-out. Heavy material is quoted by weight.' },
  { t: 'Job sites', d: 'Remodels and construction sites that need the debris gone so the crew can keep working.' },
  { t: 'Contract accounts', d: 'Recurring pulls, multi-site work, and the jobs that take more than one load.' },
];

const scale = [
  { t: 'Equipment for the job', d: 'Large loads get the trucks and equipment a job site needs, not a curbside pickup.' },
  { t: 'Built for volume', d: 'We take the big contracts: multi-load cleanouts, phased projects, and accounts with more than one address.' },
  { t: 'On your schedule', d: 'We come back as debris builds, or we clear a defined pile in one visit. You pick the cadence.' },
  { t: 'Paperwork ready', d: 'Certificate of insurance and a W-9 for your vendor file. One invoice per job, by email.' },
  { t: 'Price before we load', d: 'You get the number in writing from photos, then we confirm it on site before anything goes on the truck.' },
  { t: 'A person on the phone', d: 'One point of contact. Calls and texts come to us, not a call center.' },
];

const partners = [
  { t: 'General contractors', d: 'C&D haul-off for active job sites, phased so the work area stays clear.' },
  { t: 'Property managers', d: 'Unit turns, abandoned furniture, and common-area cleanouts on your deadline.' },
  { t: 'Remodelers', d: 'Cabinets, flooring, drywall, and packaging. No dumpster sitting in the driveway unless you want one.' },
  { t: 'Developers', d: 'Multi-unit and multi-site debris, scheduled around your trades.' },
  { t: 'Offices and retail', d: 'Furniture, fixtures, and storage rooms cleared after a close or a refresh.' },
  { t: 'HOAs', d: 'Bulk pickups, storm debris, and community cleanups.' },
];

const steps = [
  { t: 'Send the scope', d: 'Photos, addresses, and how often you need us. A big site gets a written number, not a guess.' },
  { t: 'Get set up', d: 'We send the certificate of insurance and W-9 so you can add us as a vendor.' },
  { t: 'We run the work', d: 'One contact for the account. Call when the next load is ready.' },
];

const photo = images.constructionDebris;
---

<Base
  title="Commercial Junk Removal and C&D | Dominion Haul"
  description="Commercial junk removal and construction debris haul-off in Northern Virginia. Job sites, C&D, and contract accounts. Insured, W-9 on request. Chantilly, VA."
  schema={{ type: 'WebPage', breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand">Commercial and C&D</p>
        <h1 class="mt-2 font-heading text-4xl font-extrabold tracking-tight text-stone-900 md:text-5xl">
          Junk removal built for job sites and big contracts.
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          Commercial cleanouts and construction debris, including the loads that fill more than one truck. We take large projects and ongoing accounts across Northern Virginia.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#partner-form" class={cn(buttonVariants(), 'h-11 px-5')}>Talk about a contract</a>
          <a href={phoneHref} class={cn(buttonVariants({ variant: 'outline' }), 'h-11 border-stone-300 bg-white px-5')}>
            {site.phone.display}
          </a>
        </div>
      </div>
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl ring-1 ring-stone-200"
      />
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">What we haul</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Commercial junk and C&D</h2>
      <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          work.map((item) => (
            <li class="rounded-2xl bg-[#f4f7f5] p-5">
              <h3 class="font-heading text-lg font-extrabold text-stone-900">{item.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">Scale</p>
      <h2 class="mt-2 max-w-2xl font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">
        Large projects, with the equipment the load needs.
      </h2>
      <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          scale.map((item) => (
            <li class="rounded-2xl bg-white p-5 ring-1 ring-stone-200">
              <h3 class="font-heading text-lg font-extrabold text-stone-900">{item.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.d}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-stone-500">
        We haul construction and demolition debris. We do not demolish structures, and we cannot take asbestos. If a months-long site is better served by a container, we will say so.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">Who it's for</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Accounts we run</h2>
      <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          partners.map((p) => (
            <li>
              <Card className="h-full shadow-none">
                <CardHeader>
                  <h3 class="font-heading text-lg font-extrabold text-stone-900">{p.t}</h3>
                  <p class="text-sm leading-relaxed text-stone-600">{p.d}</p>
                </CardHeader>
              </Card>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="text-sm font-semibold text-brand">Getting started</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">How a contract starts</h2>
      <ol class="mt-8 grid list-none gap-4 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li>
              <Card className="h-full shadow-none">
                <CardHeader>
                  <p class="font-heading text-sm font-extrabold text-brand">{i + 1}</p>
                  <h3 class="font-heading text-lg font-extrabold text-stone-900">{s.t}</h3>
                  <p class="text-sm leading-relaxed text-stone-600">{s.d}</p>
                </CardHeader>
              </Card>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-white" id="partner-form">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand">Vendor inquiry</p>
        <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-stone-900 md:text-4xl">Tell us about the project</h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-stone-600">
          One site or an ongoing account. Send the scope and we'll come back with a number and the paperwork.
        </p>
        <p class="mt-6 text-sm text-stone-600">
          Prefer to talk? Call <a href={phoneHref} class="font-semibold text-brand">{site.phone.display}</a>
          or email <a href={`mailto:${site.email}`} class="font-semibold text-brand">{site.email}</a>.
        </p>
      </div>

      <Card className="shadow-none">
        <CardContent>
          <form class="grid gap-4" name="partner" method="POST" data-netlify="true" data-netlify-honeypot="website-url">
            <input type="hidden" name="form-name" value="partner" />
            <p class="absolute -left-[9999px]">
              <label>Do not fill this in <input name="website-url" tabindex="-1" autocomplete="off" /></label>
            </p>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1 text-sm font-semibold text-stone-800">
                Company name
                <input name="company" type="text" autocomplete="organization" required class="h-11 rounded-lg border border-stone-200 bg-white px-3 font-normal" />
              </label>
              <label class="grid gap-1 text-sm font-semibold text-stone-800">
                Your name
                <input name="name" type="text" autocomplete="name" required class="h-11 rounded-lg border border-stone-200 bg-white px-3 font-normal" />
              </label>
              <label class="grid gap-1 text-sm font-semibold text-stone-800">
                Email
                <input name="email" type="email" autocomplete="email" required class="h-11 rounded-lg border border-stone-200 bg-white px-3 font-normal" />
              </label>
              <label class="grid gap-1 text-sm font-semibold text-stone-800">
                Phone
                <input name="phone" type="tel" autocomplete="tel" required class="h-11 rounded-lg border border-stone-200 bg-white px-3 font-normal" />
              </label>
            </div>
            <label class="grid gap-1 text-sm font-semibold text-stone-800">
              Type of business
              <select name="business-type" required class="h-11 rounded-lg border border-stone-200 bg-white px-3 font-normal">
                <option value="">Choose one</option>
                {partners.map((p) => <option>{p.t}</option>)}
                <option>Other</option>
              </select>
            </label>
            <label class="grid gap-1 text-sm font-semibold text-stone-800">
              What kind of work do you need?
              <textarea name="message" rows="4" placeholder="Job sites, C&D volume, how often you need hauling, how many addresses..." class="rounded-lg border border-stone-200 bg-white px-3 py-2 font-normal"></textarea>
            </label>
            <button type="submit" class={cn(buttonVariants(), 'h-11 w-full')}>Send project inquiry</button>
          </form>
        </CardContent>
      </Card>
    </div>
  </section>
</Base>
