---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from 'cn';
import { tiers, heavyMaterial } from '../config/pricing';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing' },
];

const featured = tiers.find((t) => t.popular) ?? tiers[1];
const rest = tiers.filter((t) => t.id !== featured.id);

const points = [
  { t: 'We do the lifting', d: 'Stairs, basements, and back yards included.' },
  { t: 'Disposal included', d: 'The dump fee is already in the price.' },
  { t: 'No extra fees', d: 'No stair, distance, or fuel charges.' },
  { t: 'Price first', d: 'You hear the number before anything goes on the truck.' },
];

const faq = [
  {
    q: 'Is the price on the site the price I pay?',
    a: 'We confirm the final number on site before we load. If the pile is smaller than it looked, the price comes down.',
  },
  {
    q: 'Do you charge by the hour?',
    a: 'No. The price is how much space it takes in the truck.',
  },
  {
    q: 'Is there a minimum?',
    a: `${tiers[0].price} is one heavy item. That is the smallest job.`,
  },
  {
    q: 'What about concrete or dirt?',
    a: `${heavyMaterial.items} are priced by weight. We quote those on site.`,
  },
];
---

<Base
  title="Junk Removal Prices | Dominion Haul, Northern Virginia"
  description={`Published prices. One heavy item ${tiers[0].price}, a living room set ${featured.price.toLowerCase()}, half a truck ${tiers[2].price.toLowerCase()}, a full truck ${tiers[3].price.toLowerCase()}.`}
  schema={{ type: 'WebPage', faq, breadcrumbs: crumbs }}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bg-brand text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 lg:grid-cols-2">
      <div>
        <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white md:text-5xl">
          What it costs
        </h1>
        <p class="mt-4 max-w-md text-lg text-white/70">
          Priced by how much space it takes in the truck.
        </p>
        <ul class="mt-8 divide-y divide-white/10">
          {
            points.map((p) => (
              <li class="flex gap-4 py-4">
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/30 bg-white/15 backdrop-blur-md">
                  <svg class="h-4 w-4 text-[#7dcea0]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                  </svg>
                </span>
                <div>
                  <p class="font-semibold text-white">{p.t}</p>
                  <p class="mt-0.5 text-sm text-white/60">{p.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-white/35 bg-white/15 p-6 shadow-2xl backdrop-blur-xl md:p-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-[#7dcea0]">Most booked</p>
            <h2 class="mt-1 font-heading text-2xl font-extrabold text-white">{featured.name}</h2>
          </div>
          <p class="font-heading text-4xl font-extrabold tracking-tight text-white">{featured.price}</p>
        </div>
        <a href="/contact" class={cn(buttonVariants(), "mt-6 h-11 w-full bg-white text-brand hover:bg-white/90")}>Get a quote</a>
        <ul class="mt-6 grid gap-3">
          {
            rest.map((t) => (
              <li class="flex items-start gap-2 text-sm text-white/80">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#7dcea0]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                </svg>
                <span>
                  <span class="block text-white">{t.name}</span>
                  <span class="text-white/60">{t.price}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-[#f4f7f5]">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <FAQ items={faq} title="Pricing questions" eyebrow="FAQ" />
    </div>
  </section>

  <CTABand heading="Send a photo" sub="We'll come back with a number from the prices above." />
</Base>
